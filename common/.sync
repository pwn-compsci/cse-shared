#! /usr/bin/env python3
import json
import os
import glob
import logging
from pathlib import Path
from datetime import datetime
import requests
from time import sleep
import random
import hashlib
import re
SYNC_BASE_DIR = '/home/hacker'
LAST_SENT_PATH = "/tmp/last_sent"

def path_has_symlink_component(path, stop_at="/"):
    """
    Return True if path or any existing parent component is a symlink.
    """
    path = os.path.abspath(path)
    stop_at = os.path.abspath(stop_at)

    try:
        common = os.path.commonpath([path, stop_at])
    except ValueError:
        return True
    if common != stop_at:
        return True

    rel_path = os.path.relpath(path, stop_at)
    if rel_path == ".":
        return os.path.islink(stop_at)

    probe = stop_at
    for part in rel_path.split(os.sep):
        probe = os.path.join(probe, part)
        try:
            if os.path.islink(probe):
                log.warning(f"Skipping path with symlink component: {probe}")
                return True
        except OSError:
            return True
    return False

def is_safe_regular_file(path):
    """
    Only allow .sync to read regular files inside the work tree.
    Symlinks are intentionally ignored to avoid copying unexpected targets.
    """
    try:
        if path_has_symlink_component(path, SYNC_BASE_DIR):
            return False
        stat_result = os.lstat(path)
        return os.path.isfile(path) and not os.path.islink(path) and stat_result.st_nlink >= 1
    except OSError as e:
        log.warning(f"Skipping unreadable candidate {path}: {e}")
        return False

def nofollow_opener(flags, mode=0o600):
    """
    Open files without following final symlinks.
    """
    def opener(path, opener_flags):
        return os.open(path, opener_flags | flags | getattr(os, "O_NOFOLLOW", 0), mode)
    return opener

# Setup logging
def setup_logging():
    """
    Set up logging to write to /var/log/sync.log
    """
    logger = logging.getLogger('sync')
    logger.setLevel(logging.INFO)
    log_formatter = logging.Formatter('%(asctime)s - %(name)s - %(levelname)s - %(message)s')
    try:

        log_handler = logging.FileHandler('/var/log/sync.log')
        log_handler.setFormatter(log_formatter)
        
        logger.addHandler(log_handler)
        
        return logger
    except PermissionError:
        print("Error: Permission denied when trying to write to /var/log/sync.log")
        # Fall back to a temporary log file
        temp_handler = logging.FileHandler('/tmp/sync.log')
        temp_handler.setFormatter(log_formatter)
        logger.addHandler(temp_handler)
        logger.warning("Logging to /tmp/sync.log due to permission issues")
        return logger
    except Exception as e:
        print(f"Error setting up logging: {str(e)}")
        return None

def read_level_config():
    """
    Opens /challenge/.config/level.json and reads the JSON data into a variable.
    
    Returns:
        dict: The parsed JSON data from the level configuration file.
    """
    try:
        with open('/challenge/.config/level.json', 'r') as f:
            config_data = json.load(f)
        return config_data
    except FileNotFoundError:
        log.info("Error: Config file not found at /challenge/.config/level.json")
        return {}
    except json.JSONDecodeError:
        log.info("Error: Invalid JSON format in config file")
        return {}
    except Exception as e:
        log.info(f"Error reading config file: {str(e)}")
        return {}

def get_most_recent_script(directory):
    """
    Find the most recent .py or .sh file in the provided directory and return its contents.
    
    Args:
        directory (str): Path to the directory to search in.
        
    Returns:
        tuple: (filename, content) of the most recent script file, or (None, None) if no files found.
    """
    try:
        # Ensure directory exists
        if not os.path.isdir(directory):
            log.info(f"Error: Directory '{directory}' does not exist")
            return None, None
        if path_has_symlink_component(directory, SYNC_BASE_DIR):
            log.warning(f"Refusing to sync from symlinked workdir: {directory}")
            return None, None
            
        # Get all regular .py and .sh files. Do not follow symlinks here.
        py_files = glob.glob(os.path.join(directory, "*.py"))
        sh_files = glob.glob(os.path.join(directory, "*.sh"))
        all_files = [
            path for path in py_files + sh_files
            if is_safe_regular_file(path)
        ]
        
        if not all_files:
            log.info(f"No .py or .sh files found in '{directory}'")
            return None, None
            
        # Get the most recent file based on modification time
        most_recent_file = max(all_files, key=lambda path: os.lstat(path).st_mtime)
        
        # Read the file contents
        with open(most_recent_file, 'r', opener=nofollow_opener(os.O_RDONLY)) as f:
            content = f.read()
            
        return os.path.basename(most_recent_file), content
        
    except Exception as e:
        log.info(f"Error finding most recent script: {str(e)}")
        return None, None

def sync_to_server(filename, content, module, level, pwn_college_id, pwn_college_name=None):
    """
    Sends the file content, module, level, and pwn_college_id to the sync API
    
    Args:
        filename (str): Name of the script file
        content (str): Content of the script file
        module (str): Module identifier
        level (str): Level identifier
        pwn_college_id (str): PWN College user ID
        
    Returns:
        bool: True if sync was successful, False otherwise
    """
    if not all([filename, content, module, level, pwn_college_id]):
        log.error("Missing required data for sync")
        log.info(f"filename: {filename}, content: {content}, module: {module}, level: {level}, pwn_college_id: {pwn_college_id}")
        return False
        
    try:
        url = "https://api.cse545.com/sync"
        
        payload = {
            'filename': filename,
            'content': content,
            'module': module,
            'level': level,
            'pwn_college_id': pwn_college_id,
            'pwn_college_name': pwn_college_name,
            'timestamp': datetime.now().isoformat()
        }
        
        log.info(f"Syncing {pwn_college_id} for {module}/{level} to server...")
        
        response = requests.post(url, json=payload, timeout=10)
        
        if response.status_code == 200:
            log.info(f"Sync successful {pwn_college_id} for {module}/{level}")
            return True
        else:
            log.error(f"Sync failed with status code: {response.status_code}")
            log.error(f"Response: {response.text}")
            return False
            
    except requests.exceptions.RequestException as e:
        log.error(f"Request error: {str(e)}")
        return False
    except Exception as e:
        log.error(f"Error during sync: {str(e)}")
        return False

def check_template_match(content):
    """
    Checks if the provided content matches exactly with the contents of
    /challenge/solve_template.py or /challenge/solve_template.sh
    
    Args:
        content (str): Content of the script file to check
        
    Returns:
        bool: True if content matches the template, False otherwise
    """
    try:
        # Check both possible template files
        template_paths = [
            '/challenge/solve_template.py',
            '/challenge/solve_template.sh',
            '/challenge/solve-template.py',
            '/challenge/solve-template.sh'
        ]
        
        for template_path in template_paths:
            if os.path.exists(template_path):
                log.info(f"Found template at {template_path}")
                with open(template_path, 'r') as f:
                    template_content = f.read()
                
                if content.strip() == template_content.strip():
                    log.info("Content matches template exactly")
                    return True
                
                # Check if content differs only in whitespace
                if ''.join(content.split()) == ''.join(template_content.split()):
                    log.info("Content matches template (ignoring whitespace)")
                    return True
        
        # If we get here, either templates don't exist or content doesn't match
        log.info("Content does not match any available templates")
        return False
        
    except Exception as e:
        log.error(f"Error checking template match: {str(e)}")
        return False

def compare_with_last_sent(filename, content):
    """
    Compare current content with the last sent content stored in /tmp/last_sent
    
    Args:
        filename (str): Name of the script file
        content (str): Content of the script file
        
    Returns:
        bool: True if content matches the last sent content, False otherwise
    """
    try:
        # Check if last_sent file exists
        if not os.path.exists(LAST_SENT_PATH):
            return False
        if os.path.islink(LAST_SENT_PATH):
            log.warning(f"Refusing to read symlinked {LAST_SENT_PATH}")
            return False
        
        # Read last sent content
        with open(LAST_SENT_PATH, 'r', opener=nofollow_opener(os.O_RDONLY)) as f:
            last_content = f.read()
        
        # Compare with current content
        return content.strip() == last_content.strip()
    except Exception as e:
        log.error(f"Error comparing with last sent content: {str(e)}")
        # If any error occurs, return False to ensure content is sent
        return False

def save_as_last_sent(content):
    """
    Save the content to /tmp/last_sent after successful sync
    
    Args:
        content (str): Content to save
    """
    try:
        with open(
            LAST_SENT_PATH,
            'w',
            opener=nofollow_opener(os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600),
        ) as f:
            f.write(content)
        os.chmod(LAST_SENT_PATH, 0o600)
        log.info(f"Saved content to {LAST_SENT_PATH}")
    except Exception as e:
        log.error(f"Error saving last sent content: {str(e)}")

def main():
    """
    Main function that reads the level configuration and displays it.
    """
    sleep(5)

    config = read_level_config()
    if config:
        module = config.get('module', 'module_unknown')
        level = config.get('level', 'level_unknown')
        challenge = config.get('challenge') or level
        course_code = config.get('course_code') or 'cse545'
        hwdir = config.get('hwdir') or os.path.join(SYNC_BASE_DIR, course_code, module)
        workdir = os.path.join(hwdir, level)
        pwn_college_id = config.get('pwn_college_id')
        pwn_college_name = config.get('pwn_college_name')
        log.info(f"Module: {module}, Level: {level}, Challenge: {challenge}, Workdir: {workdir}")
        while True:
            filename, content = get_most_recent_script(workdir)
            
            if filename and content:
                if check_template_match(content):
                    log.info("Content matches the template, syncing EMPTY.")
                    content = "NONE"
                
                log.info(f"Most recent script: {filename} content length: {len(content)}")
                
                # Check if content matches the last sent content
                if compare_with_last_sent(filename, content):
                    log.info("Content matches last sent content, skipping sync")
                else:
                    log.info("Content differs from last sent, syncing to server")
                    sync_result = sync_to_server(filename, content, module, challenge, pwn_college_id, pwn_college_name)
                    
                    # Save content as last sent if sync was successful
                    if sync_result:
                        save_as_last_sent(content)
                
            sleep(30)
        
    else:
        log.info("No configuration data available.")

if __name__ == "__main__":
    log = setup_logging()
    main()
