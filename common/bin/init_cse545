# Create symlink at /challenge/startup.log pointing to the current log file
# Remove old symlink if it exists, then create new one
rm -f /challenge/startup.log 2>/dev/null || true
ln -s "$STARTUP_LOG" /challenge/startup.log

echo "Starting setup for $module level $level at  $display_start_time ($start_time) " >> /challenge/startup.log

id >> /challenge/startup.log

rm -f "$course_home/.vscode"/trdb.db.backup_* "$course_home/.vscode"/trdb.db-journal 2>> /challenge/startup.log || true
if [ -f /home/hacker/core ]; then
    core_size=$(du -m /home/hacker/core 2>/dev/null | cut -f1)
    if [[ "$core_size" =~ ^[0-9]+$ ]] && [ "$core_size" -gt 10 ]; then
        rm -f /home/hacker/core
        echo "[i] Removed oversized /home/hacker/core (${core_size}MB)" >> /challenge/startup.log
    fi
fi
find "$course_home" -name 'core' -type f -size +10M -delete 2>> /challenge/startup.log || true

mkdir -p /challenge/bin 2>> /challenge/startup.log
# ln -s /usr/bin/{cpp,cc,c++,ld,gcc,as,gdb,g++,make,python3} /challenge/bin 2>> /challenge/startup.log

workdir="$course_home/$module/$level"
mkdir -p "$workdir"

printf "\n[update]\ninterval=never\n" >> /etc/pwn.conf

### add to /etc/bash.bashrc config before .moduleinit and .levelinit executed
cat <<'EOF' >> /etc/bash.bashrc
if [ "$(id -u)" -eq 1000 ]; then
    if command -v batcat &> /dev/null; then
        [ -n "\$TERM" -a -r /challenge/README.md ] && batcat -pp /challenge/README.md
    else
        [ -n "\$TERM" -a -r /challenge/README.md ] && cat /challenge/README.md
    fi    
    echo " "
fi
EOF

#formatted_level=$(printf "%02d" "$level")
#echo "formatted_level=$formatted_level" >> /challenge/startup.log
printf "\nalias cdhw='cd $course_home/$module/$level'\n\n" >> /etc/bash.bashrc 
printf "\nalias batlist='for f in \$(ls -tr); do ls -lat \$f; batcat --paging=never \$f; done'\n\n" >> /etc/bash.bashrc

### end commands added to /etc/bash.bashrc

echo "[i] Updating ownership of files in $workdir" >> /challenge/startup.log
chown hacker:hacker "$course_home"
chown -R hacker:hacker "$course_home/.vscode"
chown hacker:hacker "$workdir"
# echo "[i] Running the bug fixed command" >> /challenge/startup.log
