# TEST outside of .init ::> grep -q "digital god" /.admin_access
active_pwn_college_id=$(cat /proc/self/mounts | grep home| grep -ohE "homes/[0-9]+/active" | cut -d'/' -f2)

# If active_pwn_college_id is blank, try to extract it from /flag
if [ -z "$active_pwn_college_id" ] && [ -f /flag ]; then
    echo "[i] active_pwn_college_id is blank, attempting to extract from /flag" >> /challenge/startup.log
    flag_content=$(cat /flag 2>/dev/null)
    if [ -n "$flag_content" ]; then
        extracted_id=$(extract_account_id_from_flag "$flag_content")
        if [ -n "$extracted_id" ]; then
            active_pwn_college_id="$extracted_id"
            echo "[i] Extracted active_pwn_college_id from flag: $active_pwn_college_id" >> /challenge/startup.log
        else
            echo "[i] Failed to extract active_pwn_college_id from flag" >> /challenge/startup.log
        fi
    fi
fi

if [ -z "$1" ] && [ "$active_pwn_college_id" -eq "132329" ];then 
    echo "pwn_college_id='$active_pwn_college_id'" >> /.user_info
