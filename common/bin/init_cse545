    [ -e "$file" ] && chown -h hacker:hacker -- "$file"
done

# Function to extract account_id from pwn.college flag (bash version of .sync function)
extract_account_id_from_flag() {
    local flag="$1"
    
    # Extract the serialized part between braces if it's a full flag
    if [[ "$flag" =~ \{(.+)\} ]]; then
        serialized_part="${BASH_REMATCH[1]}"
    else
        serialized_part="$flag"
    fi
    
    # Reverse the serialized part
    unreversed=$(echo "$serialized_part" | rev)
    
    # Split at the dot to separate data from signature
    data_part="${unreversed%%.*}"
    
    # Add base64 padding if needed
    padding_needed=$((4 - ${#data_part} % 4))
    if [ $padding_needed -ne 4 ]; then
        data_part="${data_part}$(printf '%*s' $padding_needed | tr ' ' '=')"
    fi
    
    # Decode the base64 data part and extract account_id
    decoded=$(echo "$data_part" | base64 -d 2>/dev/null | jq -r '.[0]' 2>/dev/null)
    
    if [[ "$decoded" =~ ^[0-9]+$ ]]; then
        echo "$decoded"
    else
        echo ""
    fi
}

touch /home/hacker/.bashrc
chown hacker:hacker /home/hacker/.bashrc
chmod 766 /home/hacker/.bashrc
if ! grep -qF "alias ll='ls -alF'" /home/hacker/.bashrc; then
    echo "alias ll='ls -alF'" >> /home/hacker/.bashrc
fi
