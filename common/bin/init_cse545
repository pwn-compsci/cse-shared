        echo "[i] Successfully changed ownership of $cs_user_data_dir"
    else
        echo "[i] Failed to change ownership of $cs_user_data_dir"
    fi
    if chown hacker:hacker "/home/hacker/.local/share/" 2>/dev/null; then
        echo "[i] Successfully changed ownership of /home/hacker/.local/share/"
    else
        echo "[i] Failed to change ownership of /home/hacker/.local/share/"
    fi
    if chown hacker:hacker "/home/hacker/.local/share/ultima/" 2>/dev/null; then
        echo "[i] Successfully changed ownership of /home/hacker/.local/share/ultima/"
    else
        echo "[i] Failed to change ownership of /home/hacker/.local/share/ultima/"
    fi
    
    if [ -f /challenge/bin/.examsetup ]; then
        echo "[i] About to source .examsetup" >> "/challenge/startup.log"
        # Redirect both stdout and stderr from .examsetup to the log
        if source /challenge/bin/.examsetup >> "/challenge/startup.log" 2>&1; then
            echo "[i] Completed .examsetup for $cs_user_data_dir exit code $?" >> "/challenge/startup.log"
        else
            echo "[i] .examsetup failed with exit code $?" >> "/challenge/startup.log"
        fi
    else
        echo "[i] Cannot find /challenge/bin/.examsetup" >> "/challenge/startup.log"
    fi 
    echo "[i] exiting .examsetup if" >> "/challenge/startup.log"   
else
    echo "[i] Not an exam level" >> /challenge/startup.log    
    if [ ! -d $cs_user_data_dir ]; then 
        mkdir -p $cs_user_data_dir
        chown hacker:hacker $cs_user_data_dir/.. $cs_user_data_dir
    fi 
fi

# END Exam Setup   
echo "[i] Starting workdir and coder file setup" >> /challenge/startup.log

coder_file="$cs_user_data_dir/coder.json"
echo "[i] Checking ${coder_file} for ${workdir}" >> /challenge/startup.log

if [ -f "${coder_file}" ] && grep -q "$workdir" "${coder_file}"; then 
    echo "[i] ${coder_file} already contains ${workdir}" >> /challenge/startup.log      
else
    echo "[i] Updating ${coder_file} with ${workdir}" >> /challenge/startup.log
    printf '{
        "query": {
            "folder": "'$workdir'"
        }
    }\n' |  jq . > ${coder_file}

    chown hacker:hacker ${coder_file}
    chmod +r ${coder_file}
    echo "[i] Updated Coder file it now looks like" >> /challenge/startup.log
    cat $coder_file >> /challenge/startup.log 
    echo "-----" >> /challenge/startup.log
fi 

echo "[i] checking for /challenge/patched_dash " >> /challenge/startup.log
if [ -f /challenge/patched_dash ]; then 
    chmod 00755 /challenge/patched_dash
    # most the chals that use call directly to /bin/sh
    echo "[i] moving /challenge/patched_dash " >> /challenge/startup.log
    mv /challenge/patched_dash /bin/sh
fi 

echo "[i] checking for .prelevelinit" >> /challenge/startup.log
if [ -f /challenge/.prelevelinit ]; then
    level_start_time=$(date +%s)
    if head -n 1 /challenge/.prelevelinit | grep -q "python"; then
        python3 /challenge/.prelevelinit
    else
        source /challenge/.prelevelinit
    fi
    end_time=$(date +%s)
    execution_time=$((end_time - level_start_time))
    echo "[i] Completed .prelevelinit in .init in $execution_time seconds" >> "/challenge/startup.log"
fi 

echo "206.206.192.179   api.cse545.com" >> /etc/hosts 

touch "$course_home/.vscode/hist.log"
chown hacker:hacker "$course_home/.vscode/hist.log"
chmod 0666 "$course_home/.vscode/hist.log"
inst_id="$(basename $(jq -r '. | "\(.module)"' /challenge/.config/level.json)) $(jq -r '. | "\(.level)"' /challenge/.config/level.json)"
echo "export PROMPT_COMMAND='HISTTIMEFORMAT=\"%F %T ${inst_id} | \" history 1 >> $course_home/.vscode/hist.log && history -a'" >> /etc/bash.bashrc

# Handle solve templates - copy if no solve file exists
for ext in py sh c; do
    template_files=(/challenge/solve-template*.$ext)
    solve_files=($workdir/solve*.$ext)
    
    # Check if template exists (not just glob pattern) and no solve file exists
    if [ -f "${template_files[0]}" ] && [ ! -f "${solve_files[0]}" ]; then
        # Copy the first template file found
        cp "${template_files[0]}" "$workdir/solve.$ext"
        echo "[i] solved template copied: ${template_files[0]} to $workdir/solve.$ext" >> /challenge/startup.log
    fi
done

[ -f /challenge/main.c ] && cp /challenge/main.c $workdir

[ -f /challenge/main.rm.c ] && [ -f $workdir/main.c ] && rm -f $workdir/main.c 
[ -f /challenge/main.rm.c ] && [ -f $workdir/main.rm.c ] && rm -f $workdir/main.rm.c

echo "[i] checking for .moduleinit" >> /challenge/startup.log
# module level then .levelinit
if [ -f /challenge/.moduleinit ]; then
    mod_start_time=$(date +%s)
    source /challenge/.moduleinit >> /challenge/startup.log 2>&1
    moduleinit_exit_code=$?
    # Don't set -e since it wasn't enabled before
    if [ $moduleinit_exit_code -ne 0 ]; then
        echo "[i] .moduleinit failed with exit code $moduleinit_exit_code" >> "/challenge/startup.log"
    fi
    end_time=$(date +%s)
    execution_time=$((end_time - mod_start_time))
    echo "[i] Completed .moduleinit in .init in $execution_time seconds" >> "/challenge/startup.log" 
    
fi 

if [ -f /challenge/.levelinit ]; then
    level_start_time=$(date +%s)
    source /challenge/.levelinit    
    end_time=$(date +%s)
    execution_time=$((end_time - level_start_time))
    echo "[i] Completed .levelinit in .init in $execution_time seconds" >> "/challenge/startup.log"
fi 

# run re-chown at the end to catch any created or copied files
find /home/hacker ! -path "$course_home/*" ! -user hacker ! -type l -exec chown hacker:hacker {} + 2>> /challenge/startup.log
echo "[i] find/chown ran with $? " >> /challenge/startup.log
echo "[i] still have these files with issues " >> /challenge/startup.log
remaining_files=$(find /home/hacker ! -path "$course_home/*" ! -user hacker ! -type l)
if [ -n "$remaining_files" ]; then
    echo "[i] vvvvv Files in /home/hacker that are still not owned by hacker: vvvvv" >> /challenge/startup.log
    echo "$remaining_files" >> /challenge/startup.log
    echo "^^^^^ file not changed by chown ^^^^^^" >> /challenge/startup.log
else 
    echo "[i] All files in /home/hacker are now owned by hacker" >> /challenge/startup.log
fi

echo "[i] Checking size of ~/.config/ghidra ">> /challenge/startup.log
dir_size=$(du -sm /home/hacker/.config/ghidra 2>/dev/null | cut -f1)
echo "[i] ghidra dir_size=${dir_size}MB" >> /challenge/startup.log

# Only proceed if dir_size is a valid number
if [[ "$dir_size" =~ ^[0-9]+$ ]]; then
    # If the ghidra directory size is greater than 100 MB, remove the directory
    if [ "$dir_size" -gt 100 ]; then
        rm -rf /home/hacker/.config/ghidra
        echo "[i] Directory ~/.config/ghidra removed because it exceeded 100 MB." >> /challenge/startup.log
    else
        echo "[i] Directory ~/.config/ghidra is within the size limit." >> /challenge/startup.log
    fi
else
    echo "[i] Directory ~/.config/ghidra does not exist or is inaccessible." >> /challenge/startup.log
fi

### cleanup vscode-cpptools cache if it grows too large
cache_dir="/home/hacker/.cache/vscode-cpptools"
if [ -d "$cache_dir" ]; then
    cache_size=$(du -sm "$cache_dir" 2>/dev/null | cut -f1)

    # Only proceed if cache_size is a valid number
    if [[ "$cache_size" =~ ^[0-9]+$ ]]; then
        # If the cpptools cache directory size is greater than 200 MB, remove its contents
        if [ "$cache_size" -gt 200 ]; then
            echo "[i] vscode-cpptools cache size=${cache_size}MB exceeds 200MB — removing cache contents from $cache_dir" >> /challenge/startup.log
            # Remove directories (cache subdirs) and files inside the cache directory but keep the parent dir
            if [ -d "$cache_dir" ]; then
                find "$cache_dir" -mindepth 1 -maxdepth 1 -type d -exec rm -rf {} + 2>>/challenge/startup.log || true
                find "$cache_dir" -mindepth 1 -maxdepth 1 -type f -exec rm -f {} + 2>>/challenge/startup.log || true
                echo "[i] vscode-cpptools cache cleaned" >> /challenge/startup.log
            else
                echo "[i] vscode-cpptools cache dir not found: $cache_dir" >> /challenge/startup.log
            fi
        else
            echo "[i] vscode-cpptools cache (${cache_size}MB) is within the size limit" >> /challenge/startup.log
        fi
    else
        echo "[i] vscode-cpptools cache dir does not exist or is inaccessible: $cache_dir" >> /challenge/startup.log
    fi
else
    echo "[i] vscode-cpptools cache dir does not exist: $cache_dir" >> /challenge/startup.log
fi 

echo "[i] Checking for .bginit ">> /challenge/startup.log

if [ -f /challenge/.bginit ]; then 
    /challenge/.bginit &
fi 

echo "[i] Cleanup stage ">> /challenge/startup.log

### cleanup
if [ "$admin_access" = true ]; then
    # Copy any sln* files from /challenge to workdir for admin access
    if find /challenge -maxdepth 1 -name 'sln*' -type f | grep -q .; then
        find /challenge -maxdepth 1 -name "sln*" -type f -exec cp {} $workdir/ \;
        echo "[i] Copying from /challenge/sln*" >> /challenge/startup.log
    else 
        # Fallback to solutions directory with module-specific naming
        modnum=$(echo $module | sed -n 's/[^0-9]*0*\([0-9]\+\).*/\1/p')
        solutionfile="/home/hacker/solutions/$module/sln${modnum}-${level}.sh"
        echo "[i] solution_file=$solutionfile $([ -f $solutionfile ] && printf 'exists' )" >> /challenge/startup.log
        [ -f $solutionfile ] && ln -s $solutionfile $workdir
        solutionfile="/home/hacker/solutions/$module/sln${modnum}-${level}.py"
        echo "[i] solution_file=$solutionfile $([ -f $solutionfile ] && printf 'exists' )" >> /challenge/startup.log
        [ -f $solutionfile ] && ln -s $solutionfile $workdir    
        solutionfile="/home/hacker/solutions/$module/sln${modnum}-${level}.c"
        echo "[i] solution_file=$solutionfile $([ -f $solutionfile ] && printf 'exists' )" >> /challenge/startup.log
        [ -f $solutionfile ] && ln -s $solutionfile $workdir    
    fi 
else
    cleanup_non_admin_challenge_artifacts
fi

if [ -f /usr/share/gef/gef.py ]; then
    ln -s /usr/share/gef /opt/gef    
fi

# Disk usage check for /home/hacker — warn on interactive shell if > 750 MB
{
    usage_kb=$(du -s /home/hacker 2>/dev/null | awk '{print $1}')
    usage_kb=${usage_kb:-0}
    # convert to MB (du -s typically reports KB)
    usage_mb=$(( (usage_kb + 1023) / 1024 ))
    quota_threshold=750
    bashrc="/etc/bash.bashrc"
    marker_start="# BEGIN ${course_code^^} DISK QUOTA WARNING"
    marker_end="# END ${course_code^^} DISK QUOTA WARNING"

    if (( usage_mb > quota_threshold )); then
        echo "[i] /home/hacker usage=${usage_mb}MB exceeds ${quota_threshold}MB — ensuring warning in $bashrc" | tee -a /challenge/startup.log
        # Add the warning block if not already present
        if ! grep -Fq "$marker_start" "$bashrc"; then
            cat >> "$bashrc" <<EOF
$marker_start
if [[ -t 1 ]] && [[ -n "\$PS1" ]]; then
    echo ""
    echo "WARNING: Your /home/hacker directory is using over 750 MB. You are nearing the disk quota limit."
    echo "Top 5 files larger than 20 MB (consider deleting):"
    # list top 5 files over 20M, sorted by size (human-readable)
    find /home/hacker -type f -size +20M -exec du -h {} + 2>/dev/null | sort -hr | head -n5
    echo ""
fi
$marker_end
EOF
            echo "[i] Disk quota warning added to $bashrc" | tee -a /challenge/startup.log
        else
            echo "[i] Disk quota warning already present in $bashrc" | tee -a /challenge/startup.log
        fi
    else
        # If usage is below threshold, remove an existing warning block to avoid stale warnings
        if grep -Fq "$marker_start" "$bashrc"; then
            echo "[i] /home/hacker usage=${usage_mb}MB is below threshold — removing warning from $bashrc" | tee -a /challenge/startup.log
            sed -i '/^# BEGIN CSE240 DISK QUOTA WARNING$/,/^# END CSE240 DISK QUOTA WARNING$/d' "$bashrc" || true
        fi
    fi
}

echo "$(date '+%Y-%m-%d %H:%M:%S.%3N') finished with .init" >> /challenge/startup.log

chown hacker:hacker -R "$course_home/"
