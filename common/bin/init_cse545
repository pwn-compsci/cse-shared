rm -f /challenge/.config/info.dat
if [ -n "$pwn_college_id" ]; then
    PWN_COLLEGE_ID="$pwn_college_id" python3 - <<'PY' >> /challenge/startup.log 2>&1 || true
import csv
import json
import os
import urllib.error
import urllib.request

token_path = "/opt/.ring"
info_path = "/challenge/.config/info.dat"
pwn_college_id = os.environ.get("PWN_COLLEGE_ID", "")

try:
    with open(token_path, "r", encoding="utf-8") as token_file:
        api_token = token_file.read().strip()
except OSError as exc:
    print(f"[i] Could not read API token for student info lookup: {exc}")
    raise SystemExit(0)

payload = json.dumps({"pwn_college_id": pwn_college_id}).encode("utf-8")
request = urllib.request.Request(
    "https://api.cse545.com/student_info",
    data=payload,
    headers={
        "Content-Type": "application/json",
        "X-API-Token": api_token,
    },
    method="POST",
)

try:
    with urllib.request.urlopen(request, timeout=8) as response:
        result = json.loads(response.read().decode("utf-8"))
except urllib.error.HTTPError as exc:
    body = exc.read().decode("utf-8", errors="replace")
    print(f"[i] Student info lookup HTTP error {exc.code}: {body[:200]!r}")
    raise SystemExit(0)
except Exception as exc:
    print(f"[i] Student info lookup skipped after error: {exc}")
    raise SystemExit(0)

if result.get("status") != "success":
    print(f"[i] Student info lookup did not find a student: {result}")
    raise SystemExit(0)

row = [
    str(result.get("pwn_college_id") or pwn_college_id),
    str(result.get("sis_user_id") or ""),
    str(result.get("student_name") or result.get("name") or ""),
]
with open(info_path, "w", encoding="utf-8", newline="") as info_file:
    csv.writer(info_file).writerow(row)
print(f"[i] Wrote student info from API for pwn_college_id={pwn_college_id}: {row[1]} - {row[2]}")
PY
else
    echo "[i] Skipping student info lookup: missing pwn_college_id" >> /challenge/startup.log
fi

# If pwn_college_id is still blank, try to extract it from /flag
if [ -z "$pwn_college_id" ] && [ -f /flag ]; then
    echo "[i] pwn_college_id is blank, attempting to extract from /flag" >> /challenge/startup.log
    flag_content=$(cat /flag 2>/dev/null)
    if [ -n "$flag_content" ]; then
        extracted_id=$(extract_account_id_from_flag "$flag_content")
        if [ -n "$extracted_id" ]; then
            pwn_college_id="$extracted_id"
            echo "[i] Extracted pwn_college_id from flag: $pwn_college_id" >> /challenge/startup.log
        else
            echo "[i] Failed to extract pwn_college_id from flag" >> /challenge/startup.log
        fi
    fi
fi

echo "pwn_college_id='$pwn_college_id'" >> /.user_info

# if [ ! /home/me ] && [ "$admin_access" = true ]; then
