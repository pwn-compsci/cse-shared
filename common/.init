if [ -f "$ENVFILE" ] && grep -q "ZSH_ENABLE" "$ENVFILE" ; then 
    printf 'export PATH=$PATH:/challenge/\n' >> /etc/zsh/zshenv
    printf 'source /challenge/.config/.bashrc.config.sh\n' >> /etc/zshrc       
    echo "Changing shell for hacker to $(which zsh)" | tee -a $STARTUP_LOG
    #chsh -s $(which zsh) hacker     
    
    target_file="/etc/bash.bashrc"
    if grep -q 'Automatically switch to Zsh for interactive sessions' "$target_file"; then
        echo "Block already exists in $target_file" | tee -a $STARTUP_LOG
    else
        echo "Adding to top of $target_file" | tee -a $STARTUP_LOG
        sudo sed -i '1i\
            # Automatically switch to Zsh for interactive sessions\n\
            if [ -t 1 ] \&\& [ -n "$BASH_VERSION" ] \&\& [ -z "$ZSH_VERSION" ]; then\n\
                exec $(which zsh) || true \n\
            fi\n' $target_file
    fi
    export SHELL=$(which zsh)
else
    command_history_file="/home/hacker/.local/share/ultima/c.dat"
    mkdir -p "$(dirname "$command_history_file")"
    touch "$command_history_file"
    chmod 666 "$command_history_file"
    chown hacker:hacker "$command_history_file"

    # Extract module and challenge info once for session tracking.
    inst_id="$(jq -r '[
        ((.module | select(. != null and . != "")) // (.hwdir | split("/") | last) // "unknown"),
        if (.course_code // "" | ascii_downcase) == "cse545" then
            ((.challenge | select(. != null and . != "")) // (.level | select(. != null and . != "")) // "unknown")
        else
            ((.level | select(. != null and . != "")) // (.challenge | select(. != null and . != "")) // "unknown")
        end
    ] | join(" ")' /challenge/.config/level.json 2>/dev/null || echo "unknown unknown")"

    sed -i '/^# CSE_COMMAND_HISTORY_START$/,/^# CSE_COMMAND_HISTORY_END$/d' /etc/bash.bashrc
    cat >> /etc/bash.bashrc << HIST_EOF

# CSE_COMMAND_HISTORY_START
export INST_ID='${inst_id}'
export CSE_COMMAND_HISTORY_FILE='${command_history_file}'
__cse_log_cmd() {
    local current_histcmd="\${HISTCMD:-}"
    [ -n "\$current_histcmd" ] || return 0
    [ "\$current_histcmd" != "\${__cse_last_logged_histcmd:-}" ] || return 0
    __cse_last_logged_histcmd="\$current_histcmd"

    history -a
    history 1 | sed "s/^/\$(date '+%F %T') \${INST_ID:-unknown unknown} | /" >> "\${CSE_COMMAND_HISTORY_FILE:-/home/hacker/.local/share/ultima/c.dat}" 2>/dev/null || true
}
case ";\${PROMPT_COMMAND:-};" in
    *";__cse_log_cmd;"*) ;;
    *) PROMPT_COMMAND="__cse_log_cmd\${PROMPT_COMMAND:+; \$PROMPT_COMMAND}" ;;
esac
export PROMPT_COMMAND
# CSE_COMMAND_HISTORY_END
HIST_EOF
    
    printf 'export PATH=$PATH:/challenge/\n' >> /etc/bash.bashrc
    printf 'source /challenge/.config/.bashrc.config.sh\n' >> /etc/bash.bashrc

    sed -i '/^# CSE_COMMAND_HISTORY_USER_START$/,/^# CSE_COMMAND_HISTORY_USER_END$/d' /home/hacker/.bashrc
    cat >> /home/hacker/.bashrc << 'USER_HIST_EOF'

# CSE_COMMAND_HISTORY_USER_START
if declare -F __cse_log_cmd >/dev/null 2>&1; then
    case ";${PROMPT_COMMAND:-};" in
        *";__cse_log_cmd;"*) ;;
        *) PROMPT_COMMAND="__cse_log_cmd${PROMPT_COMMAND:+; $PROMPT_COMMAND}" ;;
    esac
    export PROMPT_COMMAND
fi
# CSE_COMMAND_HISTORY_USER_END
USER_HIST_EOF
    chown hacker:hacker /home/hacker/.bashrc
            
    printf 'echo "Added commands to BASHRC FILE!!!!" | tee -a $STARTUP_LOG '

    export SHELL=$(which bash)
fi 

## limit cpp-tools cache size to 0 for right now
JSON_FILE="/home/hacker/.local/share/code-server/Machine/settings.json"
chown hacker:hacker $JSON_FILE
if [ ! -f $JSON_FILE ] || ! grep -q "C_Cpp.intelliSenseCacheSize" $JSON_FILE; then
    TEMP_FILE=$JSON_FILE".tmp"
    if [ ! -f $JSON_FILE ]; then 
        printf '{\n  "C_Cpp.intelliSenseCacheSize": 0\n}\n' > $JSON_FILE
    else
        echo "Setting CPP Tools cache size" 
        jq '.["C_Cpp.intelliSenseCacheSize"] = 0' "$JSON_FILE" > "$TEMP_FILE" && mv "$TEMP_FILE" "$JSON_FILE"
    fi 
    
else
    echo "Skipping cache setting, already set" 
fi 

mkdir -p /challenge/.config

cat /challenge/.config/level.json | tee -a $STARTUP_LOG 
# use level config to define variables 
level=$(jq -r '.level' /challenge/.config/level.json)    
module=$(jq -r '.module' /challenge/.config/level.json)    
challenge=$(jq -r '.challenge // .level' /challenge/.config/level.json)
lab_id=$(jq -r '.labid // empty' /challenge/.config/level.json)
hw_id=$(jq -r '.hw // empty' /challenge/.config/level.json)
hwdir=$(jq -r '.hwdir // empty' /challenge/.config/level.json)

if [ -z "$hw_id" ] && [ -z "$lab_id" ]; then
    hw_id=$(printf '%s\n' "$module" | sed -n 's/^[^0-9]*\([0-9][0-9]*\).*/\1/p')
fi
if [ -z "$hwdir" ] && [ -n "$module" ]; then
    hwdir="$course_home/$module"
fi
clevel_work_dir="$hwdir/$level"

echo "clevel_work_dir=$clevel_work_dir" | tee -a $STARTUP_LOG

# user information configuration - determine pwn_college_id
pwn_college_id=$active_pwn_college_id

# If /home/me exists, try to get ID from overlays mount pattern
if [ -d /home/me ]; then 
    pwn_college_id=$(cat /proc/self/mounts | grep home| grep -ohE "homes/[0-9]+/overlays" | cut -d'/' -f2)
    echo "[i] Extracted pwn_college_id from overlays mount: $pwn_college_id" | tee -a $STARTUP_LOG
fi

# If we still don't have pwn_college_id and /home/me doesn't exist, try to extract it from the flag
# This handles cases where mount patterns change or are unavailable
if [ -z "$pwn_college_id" ] && [ ! -d /home/me ]; then
    echo "[i] pwn_college_id is empty and /home/me doesn't exist, attempting to extract from flag" | tee -a $STARTUP_LOG
    pwn_college_id=$(extract_pwn_id_from_flag)
    if [ -n "$pwn_college_id" ]; then
        echo "[i] Successfully extracted pwn_college_id from flag: $pwn_college_id" | tee -a $STARTUP_LOG
    else
        echo "[!] Could not determine pwn_college_id from any source" | tee -a $STARTUP_LOG
    fi
fi

# Fetch the current student's display info from the course API.
rm -f /challenge/.config/info.dat
if [ -n "$pwn_college_id" ]; then
    PWN_COLLEGE_ID="$pwn_college_id" python3 - <<'PY' >> "$STARTUP_LOG" 2>&1 || true
import csv
import json
import os
import sys
import urllib.error
import urllib.request

token_path = "/opt/.ring"
info_path = "/challenge/.config/info.dat"
pwn_college_id = os.environ.get("PWN_COLLEGE_ID", "")

try:
    with open(token_path, "r", encoding="utf-8") as token_file:
        api_token = token_file.read().strip()
except OSError as exc:
    print(f"[i] Could not read API token for student info lookup: {exc}")
    raise SystemExit(0)

payload = json.dumps({"pwn_college_id": pwn_college_id}).encode("utf-8")
request = urllib.request.Request(
    "https://api.cse545.com/student_info",
    data=payload,
    headers={
        "Content-Type": "application/json",
        "X-API-Token": api_token,
    },
    method="POST",
)

try:
    with urllib.request.urlopen(request, timeout=8) as response:
        result = json.loads(response.read().decode("utf-8"))
except urllib.error.HTTPError as exc:
    body = exc.read().decode("utf-8", errors="replace")
    print(f"[i] Student info lookup HTTP error {exc.code}: {body[:200]!r}")
    raise SystemExit(0)
except Exception as exc:
    print(f"[i] Student info lookup skipped after error: {exc}")
    raise SystemExit(0)

if result.get("status") != "success":
    print(f"[i] Student info lookup did not find a student: {result}")
    raise SystemExit(0)

row = [
    str(result.get("pwn_college_id") or pwn_college_id),
    str(result.get("sis_user_id") or ""),
    str(result.get("student_name") or result.get("name") or ""),
]
with open(info_path, "w", encoding="utf-8", newline="") as info_file:
    csv.writer(info_file).writerow(row)
print(f"[i] Wrote student info from API for pwn_college_id={pwn_college_id}: {row[1]} - {row[2]}")
PY
else
    echo "[i] Skipping student info lookup: missing pwn_college_id" | tee -a "$STARTUP_LOG"
fi

# Add pwn_college_id to level.json if it exists and has a value
if [ -n "$pwn_college_id" ] && [ -f /challenge/.config/level.json ]; then
    if command -v jq >/dev/null 2>&1; then
        tmpfile=$(mktemp)
        if jq --arg id "$pwn_college_id" '. + {"pwn_college_id": $id}' /challenge/.config/level.json > "$tmpfile" 2>/dev/null; then
            mv "$tmpfile" /challenge/.config/level.json
            chmod 644 /challenge/.config/level.json  # Ensure readable after mv from tempfile
        else 
            echo "[!] Failed to add pwn_college_id to level.json" | tee -a $STARTUP_LOG
            rm -f "$tmpfile"
        fi
        echo "[i] Added pwn_college_id to level.json" | tee -a $STARTUP_LOG
    else
        echo "[!] jq not available, skipping pwn_college_id addition to level.json" | tee -a $STARTUP_LOG
    fi
fi

if [ ! -f /home/hacker/.cache ]; then 
    mkdir -p /home/hacker/.cache
    chown hacker:hacker /home/hacker/.cache
fi

echo "pwn_college_id='$pwn_college_id'" >> /.user_info

report_pwn_level_attempt() {
    if [ -z "$pwn_college_id" ] || [ -z "$module" ] || [ -z "$challenge" ]; then
        echo "[i] Skipping pwn level attempt report: missing pwn_college_id/module/challenge" >> "$STARTUP_LOG"
        return 0
    fi
    if [ ! -f /opt/.ring ]; then
        echo "[i] Skipping pwn level attempt report: missing API token" >> "$STARTUP_LOG"
        return 0
    fi

    PWN_COLLEGE_ID="$pwn_college_id" \
    MODULE_ID="$module" \
    CHALLENGE_ID="$challenge" \
    LEVEL_ID="$level" \
    STARTUP_ID="$(cat /tmp/.start 2>/dev/null || date --iso-8601=seconds)" \
    python3 - <<'PY' >> "$STARTUP_LOG" 2>&1 || true
import json
import os
import urllib.error
import urllib.request

token_path = "/opt/.ring"
try:
    with open(token_path, "r", encoding="utf-8") as token_file:
        api_token = token_file.read().strip()
except OSError as exc:
    print(f"[i] Could not read API token for pwn level attempt report: {exc}")
    raise SystemExit(0)

pwn_college_id = os.environ.get("PWN_COLLEGE_ID", "")
module = os.environ.get("MODULE_ID", "")
challenge = os.environ.get("CHALLENGE_ID", "")
level = os.environ.get("LEVEL_ID", "")
startup_id = os.environ.get("STARTUP_ID", "")

def post_json(url, payload):
    data = json.dumps(payload).encode("utf-8")
    request = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(request, timeout=6) as response:
        return response.status, response.read().decode("utf-8", errors="replace")

student_payload = {
    "pwn_college_id": pwn_college_id,
    "module": module,
    "challenge": challenge,
    "api_token": api_token,
}

try:
    status, body = post_json("https://api.cse545.com/is_student", student_payload)
    is_student = body.strip().lower() == "true"
    if status != 200 or not is_student:
        print(f"[i] PWN level attempt not reported: is_student status={status} body={body.strip()!r}")
        raise SystemExit(0)

    attempt_payload = {
        "pwn_college_id": pwn_college_id,
        "module": module,
        "challenge": challenge,
        "level": level,
        "source": "level_start",
        "startup_id": startup_id,
        "api_token": api_token,
    }
    status, body = post_json("https://api.cse545.com/pwn-level-attempt", attempt_payload)
    print(f"[i] PWN level attempt report status={status} body={body[:200]!r}")
except urllib.error.HTTPError as exc:
    body = exc.read().decode("utf-8", errors="replace")
    print(f"[i] PWN level attempt report HTTP error {exc.code}: {body[:200]!r}")
except Exception as exc:
    print(f"[i] PWN level attempt report skipped after error: {exc}")
PY
}

report_pwn_level_attempt

if [ -f /challenge/.sync ] && [ ! -f /challenge/bin/file_sync.py ]; then
    touch /var/log/sync.log
    chown root:root /challenge/.sync /var/log/sync.log
    chmod 700 /challenge/.sync
    chmod 666 /var/log/sync.log
    printf "[i] Starting .sync : " >> "$STARTUP_LOG"
    python3 /challenge/.sync >> "$STARTUP_LOG" 2>&1 &
    printf "\n" >> "$STARTUP_LOG"
    echo "[i] Started .sync" >> "$STARTUP_LOG"
fi


