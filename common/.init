        source /challenge/bin/.examsetup
        echo "[i] Completed .examsetup" >> "$STARTUP_LOG"
    fi 

    # setup EXAM_REFERENCE if it exists
    if [ -f /challenge/EXAM_REFERENCE.md ]; then     
        cp /challenge/EXAM_REFERENCE.md $clevel_work_dir/EXAM_REFERENCE.md
        echo "[i] Found EXAM_REFERENCE, including in user's directory $clevel_work_dir" | tee -a $STARTUP_LOG
    fi

    # can move .vsocde and .cse240env to ro
    # nohup bash /challenge/bin/vscode.sh >> /var/log/vscode.log 2>&1  &    
else
    echo "Not an exam level" | tee -a $STARTUP_LOG
    cs_user_data_dir="/home/hacker/.local/share/code-server"
     if [ ! -d $cs_user_data_dir ]; then 
        mkdir -p $cs_user_data_dir
        chown hacker:hacker $cs_user_data_dir/.. $cs_user_data_dir
    fi 
    # if level working directory is not there then create it if creeateHWDir set in level.json
    if [[ ! -d $clevel_work_dir ]] ; then 
        grep -iq '"createHWDir".*true' /challenge/.config/level.json 
        if grep -iq '"createHWDir".*true' /challenge/.config/level.json; then 
            mkdir -p $clevel_work_dir 
            chown hacker:hacker -R $clevel_work_dir
            # if no main file then copy template files 
            if [[ ! -f $clevel_work_dir/main.c ]] && [[ ! -f $clevel_work_dir/main.cpp ]] && [[ ! -f $clevel_work_dir/main.rkt ]] && [[ ! -f $clevel_work_dir/main.pl ]]; then 
                if [ -d /challenge/template ]; then 
                    echo "[i] No main file found in $clevel_work_dir, copying template files" | tee -a $STARTUP_LOG
                    cp -a /challenge/template/* $clevel_work_dir
                    chown hacker:hacker -R $clevel_work_dir
                else
                    echo "[i] /challenge/template not found, skipping template copy" | tee -a $STARTUP_LOG
                fi 
            else
                echo "[i] The main file was found in $clevel_work_dir, skipping template copy" | tee -a $STARTUP_LOG      
            fi 
        fi
        #if [ -n "$hw_id" ] && [ "$hw_id" -eq 77 ]; then
        #    ln -s $(dirname "$clevel_work_dir")/01 $clevel_work_dir
        #fi
    fi 
    
    # Copy REFERENCE.md if it exists
    if [ -f /challenge/REFERENCE.md ]; then     
        cp /challenge/REFERENCE.md $clevel_work_dir/REFERENCE.md
        echo "[i] Found REFERENCE.md, including in user's directory $clevel_work_dir" | tee -a $STARTUP_LOG
    fi
    
    # Copy EXAM_REFERENCE.md if it exists
    if [ -f /challenge/EXAM_REFERENCE.md ]; then     
        cp /challenge/EXAM_REFERENCE.md $clevel_work_dir/EXAM_REFERENCE.md
        echo "[i] Found EXAM_REFERENCE.md, including in user's directory $clevel_work_dir" | tee -a $STARTUP_LOG
    fi

    chown hacker:hacker -R $clevel_work_dir

fi

# END Exam Setup

ensure_workspace_trust_disabled "$cs_user_data_dir"


#echo "clevel_work_dir=$clevel_work_dir" | tee -a $STARTUP_LOG
if [[ -d $clevel_work_dir ]] && [ "$hw_id" -ne 77 ]; then 
    # cleans up path
    clevel_work_dir=$(realpath $clevel_work_dir)
fi 

# copy level's template files if not already copied to working directory


# # if template does not contain student test skeletons then log it and re-add
# if grep -q "requiredUserTests"  '/challenge/.config/level.json'; then 
#     jq -r '.requiredUserTests[]' /challenge/.config/level.json | while read -r ut_path; do
#         if [ ! -d $(dirname $ut_path) ]; then 
