#!/usr/bin/env bash


# Initialize STARTUP_LOG at the very top so all functions and code can use it
# Create logs directory if it doesn't exist
mkdir -p /home/hacker/cse240/.vscode/logs
mkdir -p /home/hacker/.cache 
chown -R hacker:hacker /home/hacker/cse240/.vscode 2>/dev/null || true

# Generate log filename based on current date/time
STARTUP_LOG="/home/hacker/cse240/.vscode/logs/startup-$(date +%Y%m%d-%H%M%S).log"

# Store the log path so other scripts (.bginit, .examsetup, vscode.sh) can use the same file
echo "$STARTUP_LOG" > /tmp/.startup_log_path
chmod 644 /tmp/.startup_log_path

# Create symlink at /challenge/startup.log pointing to the current log file
# Remove old symlink if it exists, then create new one
rm -f /challenge/startup.log 2>/dev/null || true
ln -s "$STARTUP_LOG" /challenge/startup.log

# Clean up any leftover database backup and journal files to prevent disk space issues
rm -f /home/hacker/cse240/.vscode/trdb.db.backup_* 2>/dev/null || true
rm -f /home/hacker/cse240/.vscode/trdb.db-journal 2>/dev/null || true

start_time=$(date +%s)
if [[ ! -f $STARTUP_LOG ]]; then 
    echo "first time" | tee -a $STARTUP_LOG
else 
    echo "SECOND time" | tee -a $STARTUP_LOG
    exit 0    
fi 

# Delete large core file if it exists at /home/hacker/core
if [ -f /home/hacker/core ]; then
    file_size=$(stat -f %z /home/hacker/core 2>/dev/null || stat -c %s /home/hacker/core 2>/dev/null || echo 0)
    if [ "$file_size" -gt 10485760 ]; then  # 10MB in bytes
        echo "[i] Removing core file at /home/hacker/core (size: ${file_size} bytes)" | tee -a $STARTUP_LOG
        rm -f /home/hacker/core
    fi
fi

nohup bash -c '
  [ -f ~/cse240/.vscode/trdb.db ] &&
  [ $(stat -c%s ~/cse240/.vscode/trdb.db) -gt $((750*1024*1024)) ] &&
  rm -f ~/cse240/.vscode/trdb.db ~/cse240/.vscode/trdb.db-journal ' | tee -a $STARTUP_LOG 2>&1 

# Delete all core files in /home/hacker/cse240
if find /home/hacker/cse240 -name 'core' -type f -print -quit | grep -q .; then
    echo "[i] Removing core files from /home/hacker/cse240" | tee -a $STARTUP_LOG
    find /home/hacker/cse240 -name 'core' -type f -exec rm -f {} \;
fi

### cleanup vscode-cpptools cache if it grows too large
cache_dir="/home/hacker/.cache/vscode-cpptools"
cache_size=$(du -sm "$cache_dir" 2>/dev/null | cut -f1)

# Only proceed if cache_size is a valid number
if [[ "$cache_size" =~ ^[0-9]+$ ]]; then
    # If the cpptools cache directory size is greater than 200 MB, remove its contents
    if [ "$cache_size" -gt 200 ]; then
        echo "[i] vscode-cpptools cache size=${cache_size}MB exceeds 200MB — removing cache contents from $cache_dir" >> $STARTUP_LOG
        # Remove directories (cache subdirs) and files inside the cache directory but keep the parent dir
        if [ -d "$cache_dir" ]; then
            find "$cache_dir" -mindepth 1 -maxdepth 1 -type d -exec rm -rf {} + 2>>$STARTUP_LOG || true
            find "$cache_dir" -mindepth 1 -maxdepth 1 -type f -exec rm -f {} + 2>>$STARTUP_LOG || true
            echo "[i] vscode-cpptools cache cleaned" >> $STARTUP_LOG
        else
            echo "[i] vscode-cpptools cache dir not found: $cache_dir" >> $STARTUP_LOG
        fi
    else
        echo "[i] vscode-cpptools cache (${cache_size}MB) is within the size limit" >> $STARTUP_LOG
    fi
else
    echo "[i] vscode-cpptools cache dir does not exist or is inaccessible: $cache_dir" >> $STARTUP_LOG
fi


create_model_bad() { 
    # File to check for macro definitions
    file_path="/challenge/model/main.c"

    # Regular expression pattern to match MODEL_BAD_X_Y
    pattern='MODEL_BAD_([0-9]+)_([0-9]+)_([0-9]+)'

    # Check if the file exists
    if [ -f "$file_path" ] && [ -f "$file_path" ]; then  
        echo "CMD: found file $file_path" | tee -a $STARTUP_LOG
        # Read the file line by line
        while IFS= read -r line; do
            printf "$line" >> /challenge/read_main_c.log
            if [[ $line =~ $pattern ]]; then
                echo "Found pattern in line: $line" | tee -a $STARTUP_LOG 
                # Extract X and Y from the matched pattern
                x="${BASH_REMATCH[1]}"
                y="${BASH_REMATCH[2]}"
                z="${BASH_REMATCH[3]}"
                # Define the output binary file name
                output_file="/challenge/modelBad${x}.${y}.${z}.bin"

                # Compile the C program with the macro definition
                gcc -D "MODEL_BAD_${x}_${y}_${z}" -o "$output_file" "$file_path"

                if [ $? -ne 0 ]; then
                    gcc -D "MODEL_BAD_${x}_${y}_${z}" -o "$output_file" "$file_path" >> /challenge/errorlog 2>&1
                    printf "\033[31mCompilation failed for macro MODEL_BAD_${x}_${y}_${z} \033[0m\n" >> /challenge/errorlog
                fi
                if [ -f "$output_file" ]; then
                    echo "Compiled binary created: $output_file" | tee -a $STARTUP_LOG
                    strip $output_file
                    cp $output_file $clevel_work_dir    
                    chmod 0755 "$output_file" 2>/dev/null || true
                    # ensure ownership if working dir is present
                    if [ -n "$clevel_work_dir" ] && [ -d "$clevel_work_dir" ]; then
                        chown hacker:hacker "$output_file" 2>/dev/null || true
                    fi
                else
                    echo "No binary produced for MODEL_BAD_${x}_${y}_${z}" | tee -a /challenge/errorlog
                    # skip strip/cp for this iteration
                    continue
                fi
                
            fi
        done < "$file_path"
        
    fi 
}


# Function to ensure "security.workspace.trust.enabled": false is set in $1/User/settings.json
ensure_workspace_trust_disabled() {
    local user_dir="$1"
    local settings_json="$user_dir/User/settings.json"
    local tmpfile

    # Create directory if it doesn't exist
    local settings_dir="$(dirname "$settings_json")"
    mkdir -p "$settings_dir"
    chown hacker:hacker -R "$user_dir" "$settings_dir"

    # If file doesn't exist, create with the setting
    if [ ! -f "$settings_json" ]; then
        echo "[c] Creating $settings_json with workspace trust disabled" | tee -a $STARTUP_LOG
        printf '{\n  "security.workspace.trust.enabled": false\n}\n' > "$settings_json"        
        return
    fi

    # If already set, do nothing
    if grep -q '"security\.workspace\.trust\.enabled"\s*:\s*false' "$settings_json"; then
        echo "[c] Workspace trust is already disabled in $settings_json" | tee -a $STARTUP_LOG
        return
    fi

    # Add the setting using jq if possible, else append manually
    if command -v jq >/dev/null 2>&1; then
        tmpfile=$(mktemp)
        jq '. + {"security.workspace.trust.enabled": false}' "$settings_json" > "$tmpfile" && mv "$tmpfile" "$settings_json"
        echo "[c] Workspace trust is now disabled in $settings_json" | tee -a $STARTUP_LOG
    else
        # Fallback: append before last }
        sed -i '$ s/}/,\n  "security.workspace.trust.enabled": false\n}/' "$settings_json"
        echo "[c] Workspace trust is now disabled in $settings_json" | tee -a $STARTUP_LOG 
    fi
}

# Function to extract pwn_college_id from flag file
# This mimics the Python function extract_account_id_from_flag in wsgi.py
extract_pwn_id_from_flag() {
    local flag_file="${1:-/flag}"
    local extracted_id=""
    
    if [ ! -f "$flag_file" ]; then
        echo "[i] Flag file not found at $flag_file" >> $STARTUP_LOG
        return 1
    fi
    
    # Read the flag file content
    local flag_content=$(cat "$flag_file" 2>/dev/null | tr -d '[:space:]')
    
    if [ -z "$flag_content" ]; then
        echo "[i] Flag file is empty" >> $STARTUP_LOG
        return 1
    fi
    
    # Extract the serialized part between braces if it's a full flag
    local serialized_part=""
    if [[ "$flag_content" == *"pwn.college{"* ]]; then
        serialized_part=$(echo "$flag_content" | sed -n 's/.*pwn\.college{\([^}]*\)}.*/\1/p')
    else
        serialized_part="$flag_content"
    fi
    
    if [ -z "$serialized_part" ]; then
        echo "[i] Could not extract serialized part from flag" >> $STARTUP_LOG
        return 1
    fi
    
    # Reverse the serialized part (pwn.college reverses it with [::-1])
    local unreversed=$(echo "$serialized_part" | rev)
    
    # Split at the first dot to separate data from signature
    local data_part=$(echo "$unreversed" | cut -d'.' -f1)
    
    if [ -z "$data_part" ]; then
        echo "[i] Could not extract data part from flag" >> $STARTUP_LOG
        return 1
    fi
    
    # Add base64 padding if needed
    local padding=$((4 - ${#data_part} % 4))
    if [ "$padding" -ne 4 ]; then
        data_part="${data_part}$(printf '=%.0s' $(seq 1 $padding))"
    fi
    
    # Decode the base64 data part (urlsafe variant: replace - with + and _ with /)
    local decoded=$(echo "$data_part" | tr '_-' '/+' | base64 -d 2>/dev/null)
    
    if [ -z "$decoded" ]; then
        echo "[i] Could not decode base64 data from flag" >> $STARTUP_LOG
        return 1
    fi
    
    # Parse the JSON array [account_id, challenge_id] and extract the first element
    # Using grep to extract the first number from the JSON array
    extracted_id=$(echo "$decoded" | grep -oP '^\s*\[\s*\K\d+' | head -n1)
    
    if [ -n "$extracted_id" ]; then
        echo "[i] Extracted pwn_college_id from flag: $extracted_id" >> $STARTUP_LOG
        echo "$extracted_id"
        return 0
    else
        echo "[i] Could not parse account_id from decoded flag data: $decoded" >> $STARTUP_LOG
        return 1
    fi
}


