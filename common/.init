protect_cse545_init_artifacts() {
    for init_file in /challenge/.init_cse545 /challenge/.init.cse545; do
        if [ -e "$init_file" ]; then
            chown root:root "$init_file" 2>/dev/null || true
            chmod 400 "$init_file" 2>/dev/null || true
        fi
    done

    if [ -e /challenge/bin/init_cse545 ]; then
        chown root:root /challenge/bin/init_cse545 2>/dev/null || true
        chmod 500 /challenge/bin/init_cse545 2>/dev/null || true
    fi
}

cleanup_non_admin_challenge_artifacts() {
    if [ "$admin_access" != false ]; then
        return 0
    fi

    echo "[i] Non-admin cleanup: removing init, solution, and generator artifacts" | tee -a "$STARTUP_LOG"
    rm -f \
        /challenge/bin/.examsetup \
        /challenge/bin/init_cse545 \
        /challenge/.init \
        /challenge/.init_cse545 \
        /challenge/.init.cse545 \
        /challenge/.prelevelinit \
        /challenge/.levelinit \
        /challenge/.testprobleminit \
        /challenge/.moduleinit \
        /challenge/.moduleinit.tmp \
        /challenge/.bginit \
        /challenge/.examsetup \
        /challenge/solution.* \
        /challenge/sln* \
        ./*.rm ./*.rm.* 2>/dev/null || true
    find /challenge -type f \( \
        -name '.init' -o \
        -name '.init_cse545' -o \
        -name '.init.cse545' -o \
        -name '.bginit' -o \
        -name '.examsetup' -o \
        -name '.prelevelinit' -o \
        -name '.levelinit' -o \
        -name '.testprobleminit' -o \
        -name '.moduleinit' -o \
        -name '.moduleinit.*' -o \
        -name 'sln*' -o \
        -name 'solution*' -o \
        -name '*.rm' -o \
        -name '*.rm.*' \
    \) -exec rm -f {} \; 2>/dev/null || true
}

copy_solve_templates_to_workdir() {
    if [ ! -d "$clevel_work_dir" ]; then
        return 0
    fi

    for ext in py sh c; do
        template_files=(/challenge/solve-template*."$ext")
        solve_files=("$clevel_work_dir"/solve*."$ext")

        if [ -f "${template_files[0]}" ] && [ ! -f "${solve_files[0]}" ]; then
            cp "${template_files[0]}" "$clevel_work_dir/solve.$ext"
            chown hacker:hacker "$clevel_work_dir/solve.$ext" 2>/dev/null || true
            echo "[i] solve template copied: ${template_files[0]} to $clevel_work_dir/solve.$ext" | tee -a "$STARTUP_LOG"
        fi
    done
}

