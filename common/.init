        find /challenge/system_tests -type f -name '*.json' -exec chmod 744 {} \;
        find /challenge/system_tests -type d -name 'hidden_data*' -exec chmod 700 {} \;
        find /challenge/system_tests -type f -name 'stest*hidden*' -exec chmod 400 {} \;
    fi    
fi

if [ -f /challenge/.bginit ]; then 
    /challenge/.bginit &
fi 

# if [ "$admin_access" != true ]; then
