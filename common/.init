    fi
    # Start file change monitor to track edits not captured by VSCode
    if [ -f /challenge/bin/file_change_monitor.py ] && [ -d "$clevel_work_dir" ]; then 
        touch /var/log/file_changes.log
        chmod 0666 /var/log/file_changes.log
        chmod 770 /challenge/bin/file_change_monitor.py
        echo "[i] Starting file change monitor for $clevel_work_dir" | tee -a $STARTUP_LOG
        python3 /challenge/bin/file_change_monitor.py "$clevel_work_dir" /var/log/file_changes.log >> /var/log/file_change_monitor.log 2>&1 &
        echo "[i] File change monitor started with PID $!" | tee -a $STARTUP_LOG
    fi  
# fi

# this script runs as root, make sure any new files or directories are owned by hacker

