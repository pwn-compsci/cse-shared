#!/usr/bin/env bash

echo "[e] Exam level found" | tee -a /challenge/startup.log
if [ "$admin_access" = false ]; then
    # if not admin and started in practice mode then kill container b/c not allowed to practice in exam mode
    # if grep "practice" /flag; then 
    #     echo "[e] No non-admin access to exam in practice mode" | tee -a /challenge/startup.log
    #     pkill -9 -f /run/dojo/bin/sleep 
    # fi
    # TODO: REENBLE THIS !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!! 
    nohup python3 /challenge/bin/nodesktop.py > /var/log/nodesktop.log 2>&1  &
fi
timestamp=$(date '+%Y-%m-%d_%H%M')
testpass="luckystar"
shapass=$(printf "%s%s" "$testpass" "$timestamp"| sha256sum | cut -d' ' -f1)

echo "[e] the testpass=$testpass $timestamp" | tee -a /challenge/startup.log
echo "[e] shapass=$shapass" | tee -a /challenge/startup.log
sed -i 's/LETMEIN/'"$shapass"'/g' /challenge/web/nginx.conf

sed -i 's/AUTHCHALLENGE/firstpass/g' /challenge/web/app.py
sed -i 's/LETMEIN/luckystar/g' /challenge/web/app.py
sed -i "s/SHAPASS_VALUE/$shapass/g" /challenge/web/app.py

if [ -f /challenge/.config/.extra_cfg ]; then 
    chown root:root /challenge/.config/.extra_cfg
    chmod 600 /challenge/.config/.extra_cfg
fi 

# /home/me means we are doing an as_user
if [ -f /challenge/bin/session_monitor.py ] && [ ! -d /home/me ]; then
    echo "[e] Found session_monitor.py, moving to /opt/session_monitor.py" | tee -a /challenge/startup.log
    touch /var/log/session_monitor.log 
    chmod 644 /var/log/session_monitor.log 
    mv /challenge/bin/session_monitor.py /opt/session_monitor.py
    chmod 700 /opt/session_monitor.py
    python3 /opt/session_monitor.py &
else
    echo "[e] session_monitor.py not found, skipping" | tee -a /challenge/startup.log
fi

echo "[e] pwn.college id is $pwn_college_id" | tee -a /challenge/startup.log



if [ -z "$pwn_college_id" ]; then 
    echo "[e] pwn.colege id not found" | tee -a /challenge/startup.log
    sed -i "s/LEVEL_ID/Level $level/g" /challenge/web/js/exam-badge.js
else
    combined=""
    if [ -f /challenge/.config/info.dat ]; then
        echo "[e] found file /challenge/.config/info.dat using pwn_college_id=$pwn_college_id" | tee -a /challenge/startup.log
        student_info=$(awk -F',' -v id="$pwn_college_id" '$1 == id && $3 ~ /^[A-Za-z0-9\-_ ]+$/ {print $2 " - " $3; exit}' /challenge/.config/info.dat)
        echo "[e] found file studentinfo $student_info" | tee -a /challenge/startup.log
        if [ -z "$student_info" ]; then
            student_info="Student not found"            
        fi
        combined="$pwn_college_id - $student_info"
        echo "[e] found combined of $combined" | tee -a /challenge/startup.log
    else
        echo "[e] /challenge/.config/info.dat not found, using pwn_college_id only" | tee -a /challenge/startup.log
        combined="$pwn_college_id - No student info"
    fi
        
    echo "[e] attempting to re-write exam-badge.js" | tee -a /challenge/startup.log
    sed -i "s/LEVEL_ID/Level $level - $combined/g" /challenge/web/js/exam-badge.js
    
fi 

if [ -d /home/me ]; then 
    echo "[e] Running as_user, not configuring problem" | tee -a /challenge/startup.log
else
        
    echo "[e] Using clevel_work_dir = $clevel_work_dir for exam base directory" | tee -a /challenge/startup.log
    if [[ -f $clevel_work_dir/main.c ]] || [[ -f $clevel_work_dir/main.cpp ]] || [[ -f $clevel_work_dir/main.rkt ]] || [[ -f $clevel_work_dir/main.pl ]]; then         
        mv "$clevel_work_dir" "${clevel_work_dir}_$timestamp"
        echo "[e] created backup of old answer attempt" | tee -a /challenge/startup.log
    fi 

    # List only directories in /challenge/problems
    dirs=($(find /challenge/problems -mindepth 1 -maxdepth 1 -type d -printf '%f\n'))

    # Check if the list is not empty
    if [ ${#dirs[@]} -eq 0 ]; then
        echo "[e] No problem directories found in /challenge/problems" >> /challenge/startup.log
        exit 1
    fi

    # Pick a random directory
    chosen_problem="${dirs[RANDOM % ${#dirs[@]}]}"
    echo "[e] Randomly chosen problem: $chosen_problem" >> /challenge/startup.log

    # for debugging
    # override random if examLevel is set
    if [ -f /home/hacker/cse240/.examproblems.json ]; then
        examLevel=$(python3 -c "import json; data=json.load(open('/challenge/.config/level.json')); print(data.get('examLevel', ''))" 2>/dev/null)        
        exam_problem=$(jq -r --arg level "$examLevel" '.[$level] // empty' /home/hacker/cse240/.examproblems.json)
        if [ -n "$exam_problem" ]; then
            chosen_problem="$exam_problem"
            echo "[e] Overriding chosen_problem from .examproblems.json: $chosen_problem" | tee -a /challenge/startup.log
        fi
    fi

    cp -a /challenge/problems/$chosen_problem/. /challenge/

    # removed /challenge/system_tests/*.json
    if [ "$admin_access" = false ]; then
        rm -rf /challenge/problems 
        rm -rf /challenge/model 
    fi
    
    json_tests=""
    dat_tests=""
    model_code=""

    model_code=$(find /challenge/model -type f \( -name "*.c" -o -name "*.c.j2" -o -name "*.h" -o -name "*.h.j2" -o -name "*.cpp" -o -name "*.cpp.j2" -o -name "*.java" -o -name "*.java.j2" -o -name "Makefile*" -o -name "*.rkt.j2" \) 2>/dev/null |  tr '\n' ' ')

    json_tests=$(find /challenge/system_tests/ -type f \( -name "*.json" -o -name "*.json.j2" -o -name "*.dat" -o -name "*.dat.j2" -o -name "*Makefile.j2" \) 2>/dev/null | tr '\n' ' ')
    
    template_files=$(find /challenge/template -type f \( -name "*.c" -o -name "*.c.j2" -o -name "*.h" -o -name "*.h.j2" -o -name "*.cpp" -o -name "*.cpp.j2" -o -name "*.java" -o -name "*.java.j2" -o -name "*.dat" -o -name "*.dat.j2" -o -name "Makefile*" -o -name "*.rkt.j2" -o -name 'README.*' \) 2>/dev/null  | tr '\n' ' ')

    levelinit_file=$(find /challenge/ -type f \( -name ".levelinit*" -o -name ".testprobleminit.j2"  \) 2>/dev/null  | tr '\n' ' ')
    
    # Call problem_generator.py with the appropriate arguments
    python3 /challenge/bin/problem_generator.py /challenge/web/nginx.conf $model_code $levelinit_file $template_files $json_tests $dat_tests | tee -a /challenge/startup.log 2>&1

    echo "[e] generated problem files" | tee -a /challenge/startup.log

    # If nothing exists at $clevel_work_dir/system_tests then cp -a /challenge/system_tests
    if [ ! -e "$clevel_work_dir/system_tests" ]; then
        echo "[e] $clevel_work_dir/system_tests does not exist, copying from /challenge/system_tests" | tee -a /challenge/startup.log
        ls -la /challenge | tee -a /challenge/challenge.log
        mkdir -p "$clevel_work_dir/system_tests"
        cp -a /challenge/system_tests/. "$clevel_work_dir/system_tests/" || true 
        ls -la "$clevel_work_dir" | tee -a /challenge/startup.log
    elif [ -L "$clevel_work_dir/system_tests" ]; then
        echo "[e] $clevel_work_dir/system_tests is a symlink, removing and copying from /challenge/system_tests" | tee -a /challenge/startup.log
        rm "$clevel_work_dir/system_tests"
        mkdir -p "$clevel_work_dir/system_tests"
        cp -a /challenge/system_tests/. "$clevel_work_dir/system_tests/" || true 
    fi
    find $clevel_work_dir -type f -name 'stest*hidden*' -exec rm -f {} \;    
fi 

if [ -f /challenge/.testprobleminit ]; then
    source /challenge/.testprobleminit
    echo "[e] Completed .testprobleminit" >> "/challenge/startup.log"
    # rm /challenge/.testprobleminit
fi 

# c_level_work_dir comes from parent call .init, .examsetup is sourced
echo "[e] creating clevel_work_dir = $clevel_work_dir in .examsetup" | tee -a /challenge/startup.log

mkdir -p $clevel_work_dir
if [ -d /challenge/template ]; then 
    echo "[e] Copying template files to $clevel_work_dir from /challenge/template " | tee -a /challenge/startup.log
    cp -a /challenge/template/* $clevel_work_dir
    chown hacker:hacker -R $clevel_work_dir
fi 
if [ "$admin_access" = true ]; then
    if [ -d /challenge/model ]; then
        cp -a /challenge/model/* $clevel_work_dir
        chown hacker:hacker -R $clevel_work_dir
    fi
fi 

# bridges to tester because tester must run using setuid 
/challenge/bin/bridge_landrun.sh > /var/log/bridge_landrun.log 2>&1 &

sleep .1

# # need all directories setup before 
# # landrun secures the directories

hwdir=$(jq -r '.hwdir' /challenge/.config/level.json)
echo "[e] project directory is $hwdir, setting up coder_workspace_file"
# hw_id and level come from parent call .init, .examsetup is sourced
coder_workspace_file="$hwdir/proj-$hw_id-$level.code-workspace"

if [ ! -f "$coder_workspace_file" ]; then 
    touch $coder_workspace_file
    # coder_workspace_file="/home/hacker/cse240/pretest/$hw_id/proj-$hw_id-$level.code-workspace"
fi 
chown hacker:hacker $coder_workspace_file 

# cs_user_data_dir comes from parent call .init, .examsetup is sourced
mkdir -p $cs_user_data_dir
# eventually make && with chown
chown hacker:hacker $cs_user_data_dir
# mkdir -p $(dirname $coder_workspace_file)

history_dir="$cs_user_data_dir/User/History"
# Setup FIFOs if missing
echo "[e] Starting vscode with $clevel_work_dir, $coder_workspace_file, and $cs_user_data_dir  " | tee -a /challenge/startup.log

# background is necessary because landrun blocks waiting for ready but .init blocks ready
/challenge/bin/vscode.sh "$clevel_work_dir" "$coder_workspace_file" "$coder_workspace_file"  | tee -a /challenge/startup.log 2>&1 &

# Start nginx with error checking
if command -v nginx >/dev/null 2>&1; then
    nohup nginx -c /challenge/web/nginx.conf > /challenge/web/nginx.log 2>&1 &
    echo "[e] Started nginx" | tee -a /challenge/startup.log
else
    echo "[e] WARNING: nginx not found, skipping" | tee -a /challenge/startup.log
fi

echo "[e] Starting flask app" | tee -a /challenge/startup.log
nohup python3 /challenge/web/app.py > /var/log/nginx/flask.log 2>&1 & 

echo "[e] Completed code-server" | tee -a /challenge/startup.log

echo "[e] $(date '+%Y-%m-%d %H:%M:%S.%3N') waiting for nginx and app server to startup" | tee -a /challenge/startup.log

count=0 
max_attempts=20

while [ $count -lt $max_attempts ]; do
    /bin/curl --max-time 1 -fs localhost:8080/ >> /challenge/startup.log 2>&1
    res=$?
    if [ $res -eq 0 ]; then
        echo "[e] $(date '+%Y-%m-%d %H:%M:%S.%3N') Service on port 8080 is ready" | tee -a /challenge/startup.log
        break
    fi
    echo "Exit code: $res" | tee -a /challenge/startup.log
    echo "[e] $(date '+%Y-%m-%d %H:%M:%S.%3N') waiting (attempt $((count+1))/$max_attempts)" | tee -a /challenge/startup.log

    ((count++))
done

if [ $count -ge $max_attempts ]; then
    echo "[e] WARNING: Service on port 8080 did not start after $max_attempts attempts" | tee -a /challenge/startup.log
else
    echo "[e] $(date '+%Y-%m-%d %H:%M:%S.%3N') nginx and app server should be up" | tee -a /challenge/startup.log

fi

