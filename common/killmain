#!/bin/bash
# killmain - Kill all running main.bin processes with retry logic

set -euo pipefail

MAX_RETRIES=5
RETRY_DELAY=1
SIGNAL="TERM"
FORCE_KILL_AFTER_RETRIES=true

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Find and kill main.bin processes with retry logic
kill_main_bin() {
    local attempt=1
    local killed_count=0
    
    while [ $attempt -le $MAX_RETRIES ]; do
        # Find all main.bin processes
        local pids=$(pgrep -f "main\.bin" || true)
        
        if [ -z "$pids" ]; then
            if [ $attempt -eq 1 ]; then
                log_info "No main.bin processes found"
            else
                log_info "All main.bin processes killed successfully"
            fi
            return 0
        fi
        
        # Count current processes
        local count=$(echo "$pids" | wc -w)
        log_warn "Attempt $attempt/$MAX_RETRIES: Found $count main.bin process(es)"
        
        if [ $attempt -eq 1 ]; then
            killed_count=$count
        fi
        
        # Kill processes with current signal
        for pid in $pids; do
            log_warn "  Killing PID $pid with signal $SIGNAL"
            if kill -$SIGNAL "$pid" 2>/dev/null; then
                log_info "    Sent $SIGNAL to PID $pid"
            else
                log_error "    Failed to send $SIGNAL to PID $pid"
            fi
        done
        
        # Wait before checking if processes are still alive
        if [ $attempt -lt $MAX_RETRIES ]; then
            sleep $RETRY_DELAY
        fi
        
        # Check if we need to escalate to SIGKILL
        if [ $attempt -eq $((MAX_RETRIES - 1)) ] && [ "$FORCE_KILL_AFTER_RETRIES" = true ]; then
            # Next attempt will use SIGKILL
            log_warn "Final attempt will use SIGKILL if processes still exist"
            SIGNAL="KILL"
        fi
        
        ((attempt++))
    done
    
    # Final check
    local remaining=$(pgrep -f "main\.bin" || true)
    if [ -z "$remaining" ]; then
        log_info "Successfully killed all $killed_count main.bin process(es)"
        return 0
    else
        local remain_count=$(echo "$remaining" | wc -w)
        log_error "Failed to kill $remain_count main.bin process(es) after $MAX_RETRIES attempts"
        log_error "Remaining PIDs: $remaining"
        return 1
    fi
}

# Main execution
main() {
    log_info "Starting main.bin termination script"
    log_info "Max retries: $MAX_RETRIES, Retry delay: ${RETRY_DELAY}s"
    
    if kill_main_bin; then
        log_info "Script completed successfully"
        exit 0
    else
        log_error "Script completed with errors"
        exit 1
    fi
}

main "$@"
