#!/bin/bash
#
# Exam Attempt Limit Checker
#
# This script checks if a student has exceeded their exam attempt limits.
# If blocked, it:
# 1. Replaces the flag with ATTEMPT_LIMIT_REACHED_{id}
# 2. Replaces main source file with block message
# 3. Deletes other source files
# 4. Adds a bashrc message
#
# Usage: Called from .examsetup or challenge setup scripts

# set -e
echo "Starting exam attempt check at $(date)" >> /var/log/attempt_check.log

# Configuration
API_URL="${API_URL:-https://api.cse545.com}"
API_TOKEN=$(cat /opt/.ring | tr -d '[:space:]')
LEVEL_CONFIG="/challenge/.config/level.json"
LOG_FILE="/var/log/attempt_check.log"
RETRY_INTERVAL=30

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to log messages
log() {
    local timestamp="[$(date '+%Y-%m-%d %H:%M:%S')]"
    echo "$timestamp $*" >> "$LOG_FILE" 2>&1
    echo "$timestamp $*" >&2
}

# Function to get level working directory
get_level_work_dir() {
    log "DEBUG: Reading level config from $LEVEL_CONFIG"
    if [ ! -f "$LEVEL_CONFIG" ]; then
        log "ERROR: Level config not found at $LEVEL_CONFIG"
        return 1
    fi
    
    local work_dir=$(jq -r '. | "\(.hwdir)/\(.level)"' "$LEVEL_CONFIG")
    log "DEBUG: Extracted work_dir: $work_dir"
    echo "$work_dir"
}

# Function to get level and module info
get_level_info() {
    log "DEBUG: Extracting level and module info from $LEVEL_CONFIG"
    if [ ! -f "$LEVEL_CONFIG" ]; then
        log "ERROR: Level config not found at $LEVEL_CONFIG"
        return 1
    fi
    
    LEVEL=$(jq -r '.level' "$LEVEL_CONFIG")
    MODULE=$(jq -r '.module' "$LEVEL_CONFIG")
    
    log "DEBUG: Raw extraction - LEVEL: $LEVEL, MODULE: $MODULE"
    
    if [ -z "$LEVEL" ] || [ "$LEVEL" == "null" ]; then
        log "ERROR: Could not extract level from config"
        return 1
    fi
    
    if [ -z "$MODULE" ] || [ "$MODULE" == "null" ]; then
        log "ERROR: Could not extract module from config"
        return 1
    fi
    
    log "DEBUG: Successfully extracted - MODULE: $MODULE, LEVEL: $LEVEL"
    echo "$MODULE|$LEVEL"
}

# Function to check attempt limit via API
check_attempt_limit() {
    local pwn_college_id="$1"
    local module="$2"
    local challenge="$3"
    
    log "INFO: Checking attempt limit for user: $pwn_college_id, module: $module, challenge: $challenge"
    log "DEBUG: API_URL: ${API_URL}/exam-attempts/check"
    log "DEBUG: Request payload: {pwn_college_id: $pwn_college_id, module: $module, challenge: $challenge}"
    
    # Make API call
    local response=$(curl -s -w "\n%{http_code}" -X POST "${API_URL}/exam-attempts/check" \
        -H 'Content-Type: application/json' \
        -H "X-API-Token: ${API_TOKEN}" \
        -d "{
            \"pwn_college_id\": \"${pwn_college_id}\",
            \"module\": \"${module}\",
            \"challenge\": \"${challenge}\"
        }" 2>&1)
    
    local http_code=$(echo "$response" | tail -n1)
    local response_body=$(echo "$response" | sed '$d')
    
    log "DEBUG: HTTP Status Code: $http_code"
    log "DEBUG: Response body: $response_body"
    
    # Check if API call failed
    if [ -z "$response_body" ] || [ "$http_code" != "200" ]; then
        log "ERROR: API call failed - HTTP $http_code"
        log "ERROR: Could not check attempt limits (API unavailable or error)"
        return 2  # Return error code for retry
    fi
    
    # Parse response
    log "DEBUG: Parsing JSON response"
    local allowed=$(echo "$response_body" | jq -r '.allowed' 2>/dev/null)
    local reason=$(echo "$response_body" | jq -r '.reason' 2>/dev/null)
    local attempts=$(echo "$response_body" | jq -r '.details.attempts // 0' 2>/dev/null)
    local first_threshold=$(echo "$response_body" | jq -r '.details.first_threshold // 3' 2>/dev/null)
    local final_threshold=$(echo "$response_body" | jq -r '.details.final_threshold // 5' 2>/dev/null)
    
    log "DEBUG: Parsed values - allowed: $allowed, reason: $reason, attempts: $attempts, first_threshold: $first_threshold, final_threshold: $final_threshold"
    
    # Export for use in main script
    export ATTEMPT_ALLOWED="$allowed"
    export ATTEMPT_REASON="$reason"
    export ATTEMPT_COUNT="$attempts"
    export ATTEMPT_FIRST_THRESHOLD="$first_threshold"
    export ATTEMPT_FINAL_THRESHOLD="$final_threshold"
    
    log "INFO: API Response: allowed=$allowed, reason=$reason, attempts=$attempts/$final_threshold"
    
    if [ "$allowed" != "true" ]; then
        log "INFO: Attempt BLOCKED - Reason: $reason"
        return 1  # Blocked
    fi
    
    log "INFO: Attempt ALLOWED"
    return 0  # Allowed
}

# Function to save and replace flag (similar to attendance_check.py)
save_and_replace_flag() {
    local work_dir="$1"
    local flag_file="${work_dir}/flag"
    
    log "DEBUG: Checking for flag file at $flag_file"
    if [ ! -f "$flag_file" ]; then
        log "WARNING: No flag file found at $flag_file"
        return 0
    fi
    
    # Read the original flag
    local original_flag=$(cat "$flag_file")
    log "DEBUG: Original flag: $original_flag"
    
    # Extract the ID portion (everything after the last underscore)
    # Flag format is typically: pwn.college{...}_uniqueid
    local flag_id=""
    if [[ "$original_flag" =~ _([^_]+)$ ]]; then
        flag_id="${BASH_REMATCH[1]}"
        log "DEBUG: Extracted flag ID: $flag_id"
    fi
    
    # Create backup
    cp "$flag_file" "${flag_file}.backup" 2>/dev/null || true
    log "DEBUG: Created backup at ${flag_file}.backup"
    
    # Replace with ATTEMPT_LIMIT_REACHED plus original ID
    if [ -n "$flag_id" ]; then
        echo "ATTEMPT_LIMIT_REACHED_${flag_id}" > "$flag_file"
        log "INFO: Flag replaced with ATTEMPT_LIMIT_REACHED_${flag_id}"
    else
        echo "ATTEMPT_LIMIT_REACHED" > "$flag_file"
        log "INFO: Flag replaced with ATTEMPT_LIMIT_REACHED"
    fi
}

# Function to create block message based on threshold type
create_block_message() {
    local reason="$1"
    local module="$2"
    local challenge="$3"
    local attempts="$4"
    local first_threshold="$5"
    local final_threshold="$6"
    
    if [ "$reason" == "final_threshold" ]; then
        cat <<EOF
===============================================
MAXIMUM ATTEMPTS REACHED
===============================================

You have reached the maximum number of attempts
for this exam problem and cannot attempt it again.

Problem: ${module}/${challenge}
Attempts: ${attempts}/${final_threshold}

If you believe this is an error or have extenuating
circumstances, please contact course staff immediately.

You may continue working on other exam problems.
===============================================
EOF
    else
        cat <<EOF
===============================================
STAFF CONSULTATION REQUIRED
===============================================

You have reached ${first_threshold} attempts on this problem.

Before you can attempt this problem again, you MUST
meet with a TA or instructor for assistance.

Problem: ${module}/${challenge}
Current Attempts: ${attempts}

What to do:
1. Visit office hours or request help during lab
2. A staff member will review your approach
3. After consultation, staff will clear you to continue

You may work on other exam problems while waiting.
===============================================
EOF
    fi
}

# Function to replace main source file with block message
replace_main_file() {
    local work_dir="$1"
    local block_message="$2"
    local main_file=""
    
    # Find main.c or main.cpp
    if [ -f "${work_dir}/main.c" ]; then
        main_file="${work_dir}/main.c"
    elif [ -f "${work_dir}/main.cpp" ]; then
        main_file="${work_dir}/main.cpp"
    else
        log "WARNING: No main.c or main.cpp found"
        return 1
    fi
    
    # Backup original
    cp "$main_file" "${main_file}.backup" 2>/dev/null || true
    
    # Replace with block message
    cat > "$main_file" <<EOF
/*
$block_message
*/
EOF
    
    chmod 444 "$main_file"  # Make read-only
    log "Replaced source file: $main_file"
}

# Function to delete other source files
delete_other_source_files() {
    local work_dir="$1"
    local keep_file="$2"  # main.c or main.cpp to keep
    
    log "Deleting other source files in $work_dir (keeping $keep_file)"
    
    # Delete all .c, .h, .cpp files except the one we're keeping
    find "$work_dir" -maxdepth 1 -type f \( -name "*.c" -o -name "*.h" -o -name "*.cpp" \) ! -name "$(basename "$keep_file")" -delete 2>/dev/null || true
    
    log "Source files deleted"
}

# Function to add attempt count message to bashrc (for all students)
add_attempt_count_message() {
    local module="$1"
    local challenge="$2"
    local attempts="$3"
    local first_threshold="$4"
    local final_threshold="$5"
    
    local bashrc_file="/etc/bash.bashrc"
    local marker="# ATTEMPT_COUNT_${module}_${challenge}"
    
    # Remove old message if exists
    if grep -q "$marker" "$bashrc_file" 2>/dev/null; then
        log "DEBUG: Removing old attempt count message"
        sed -i "/^$marker$/,+1d" "$bashrc_file" 2>/dev/null || true
    fi
    
    # Create message based on current attempt count
    local message=""
    if [ "$attempts" -lt "$first_threshold" ]; then
        local remaining=$((first_threshold - attempts))
        message="echo -e '${YELLOW}📝 ${module}/${challenge}: ${attempts}/${final_threshold} attempts used. If unable to solve in ${remaining} more attempt(s), you will be required to speak with course staff.${NC}'"
    else
        local remaining=$((final_threshold - attempts))
        if [ "$remaining" -gt 0 ]; then
            message="echo -e '${YELLOW}⚠ ${module}/${challenge}: ${remaining} of ${final_threshold} exam attempts remaining - Staff consultation required before next attempt${NC}'"
        else
            message="echo -e '${RED}⛔ ${module}/${challenge}: Maximum attempts (${final_threshold}) reached${NC}'"
        fi
    fi
    
    # Append to bashrc
    {
        echo "$marker"
        echo "$message"
    } >> "$bashrc_file" 2>/dev/null || {
        log "WARNING: Could not write to $bashrc_file (no sudo access)"
        return 1
    }
    
    log "INFO: Added attempt count message to bashrc"
}

# Function to add bashrc message (for blocked students)
add_bashrc_message() {
    local module="$1"
    local challenge="$2"
    local reason="$3"
    
    local bashrc_file="/etc/bash.bashrc"
    local marker="# ATTEMPT_LIMIT_MESSAGE_${module}_${challenge}"
    
    # Check if message already exists
    if grep -q "$marker" "$bashrc_file" 2>/dev/null; then
        log "Bashrc message already exists"
        return 0
    fi
    
    # Create message
    local message=""
    if [ "$reason" == "final_threshold" ]; then
        message="echo -e '${RED}⚠ MAXIMUM ATTEMPTS REACHED for ${module}/${challenge}${NC}'"
    else
        message="echo -e '${YELLOW}⚠ Staff consultation required for ${module}/${challenge} - visit office hours${NC}'"
    fi
    
    # Append to bashrc
    {
        echo ""
        echo "$marker"
        echo "$message"
    } >> "$bashrc_file" 2>/dev/null || {
        log "WARNING: Could not write to $bashrc_file (no sudo access)"
        return 1
    }
    
    log "Added bashrc message"
}

# Function to check if user is an admin
is_admin() {
    local admin_file="/.admin_access"
    
    if [ ! -f "$admin_file" ]; then
        return 1  # Not admin (file doesn't exist)
    fi
    
    # Check if file contains "digital god"
    if grep -q "digital god" "$admin_file" 2>/dev/null; then
        return 0  # Is admin
    fi
    
    return 1  # Not admin
}

# Function to remove template files
remove_template_files() {
    local template_dir="/challenge/template"
    
    # Check if user is admin
    if is_admin; then
        log "User is admin - preserving template files"
        return 0
    fi
    
    # Remove template directory if it exists
    if [ -d "$template_dir" ]; then
        rm -rf "$template_dir" 2>/dev/null || {
            log "WARNING: Could not remove template directory (permission issue)"
            return 1
        }
        log "Removed template directory: $template_dir"
    else
        log "Template directory does not exist: $template_dir"
    fi
}

# Main execution
main() {
    log "=========================================="
    log "Exam Attempt Limit Checker - Starting"
    log "=========================================="
    log "DEBUG: Script version: 2.0"
    log "DEBUG: Log file: $LOG_FILE"
    log "DEBUG: API URL: $API_URL"
    log "DEBUG: Retry interval: ${RETRY_INTERVAL}s"
    
    # Get PWN College ID (from environment or user)
    PWN_COLLEGE_ID="${USER:-${PWN_USER_ID}}"
    if [ -z "$PWN_COLLEGE_ID" ]; then
        log "ERROR: Could not determine PWN College ID"
        exit 1
    fi
    log "INFO: PWN College ID: $PWN_COLLEGE_ID"
    
    # Get level working directory
    LEVEL_WORK_DIR=$(get_level_work_dir)
    if [ $? -ne 0 ] || [ -z "$LEVEL_WORK_DIR" ]; then
        log "ERROR: Could not determine level working directory"
        exit 1
    fi
    log "INFO: Level working directory: $LEVEL_WORK_DIR"
    
    # Get level and module info
    INFO=$(get_level_info)
    if [ $? -ne 0 ]; then
        log "ERROR: Could not extract level/module info"
        exit 1
    fi
    
    MODULE=$(echo "$INFO" | cut -d'|' -f1)
    LEVEL=$(echo "$INFO" | cut -d'|' -f2)
    log "INFO: Module: $MODULE, Level: $LEVEL"
    
    # Retry loop - keep checking until API succeeds
    local retry_count=0
    while true; do
        retry_count=$((retry_count + 1))
        log "INFO: Attempt limit check #$retry_count"
        
        # Check attempt limit
        check_attempt_limit "$PWN_COLLEGE_ID" "$MODULE" "$LEVEL"
        local check_result=$?
        
        if [ $check_result -eq 0 ]; then
            # Allowed - add attempt count message to bashrc
            log "INFO: Attempt ALLOWED: ${ATTEMPT_COUNT}/${ATTEMPT_FINAL_THRESHOLD}"
            add_attempt_count_message "$MODULE" "$LEVEL" "$ATTEMPT_COUNT" "$ATTEMPT_FIRST_THRESHOLD" "$ATTEMPT_FINAL_THRESHOLD"
            echo "Exam attempt check: ALLOWED (${ATTEMPT_COUNT}/${ATTEMPT_FINAL_THRESHOLD})"
            exit 0
        elif [ $check_result -eq 1 ]; then
            # Blocked - proceed to enforcement
            log "INFO: Attempt BLOCKED - proceeding with enforcement"
            break
        else
            # Error (code 2) - retry
            log "WARNING: API check failed (attempt #$retry_count), retrying in ${RETRY_INTERVAL}s..."
            echo "Checking attempt limit... (attempt #$retry_count, retrying in ${RETRY_INTERVAL}s)"
            sleep "$RETRY_INTERVAL"
            continue
        fi
    done
    
    # Student is BLOCKED - enforce restrictions
    log "INFO: ========================================"
    log "INFO: STUDENT BLOCKED - Enforcing restrictions"
    log "INFO: Reason: $ATTEMPT_REASON"
    log "INFO: Attempts: ${ATTEMPT_COUNT}/${ATTEMPT_FINAL_THRESHOLD}"
    log "INFO: ========================================"
    
    # Save and replace flag
    log "STEP 1: Replacing flag"
    save_and_replace_flag "$LEVEL_WORK_DIR"
    
    # Create block message
    log "STEP 2: Creating block message"
    BLOCK_MESSAGE=$(create_block_message "$ATTEMPT_REASON" "$MODULE" "$LEVEL" \
                    "$ATTEMPT_COUNT" "$ATTEMPT_FIRST_THRESHOLD" "$ATTEMPT_FINAL_THRESHOLD")
    log "DEBUG: Block message created (${#BLOCK_MESSAGE} bytes)"
    
    # Replace main source file
    log "STEP 3: Replacing main source file"
    replace_main_file "$LEVEL_WORK_DIR" "$BLOCK_MESSAGE"
    MAIN_FILE=""
    if [ -f "${LEVEL_WORK_DIR}/main.c" ]; then
        MAIN_FILE="${LEVEL_WORK_DIR}/main.c"
        log "DEBUG: Main file is main.c"
    elif [ -f "${LEVEL_WORK_DIR}/main.cpp" ]; then
        MAIN_FILE="${LEVEL_WORK_DIR}/main.cpp"
        log "DEBUG: Main file is main.cpp"
    else
        log "WARNING: No main file found"
    fi
    
    # Delete other source files
    if [ -n "$MAIN_FILE" ]; then
        log "STEP 4: Deleting other source files"
        delete_other_source_files "$LEVEL_WORK_DIR" "$MAIN_FILE"
    else
        log "STEP 4: Skipped (no main file)"
    fi
    
    # Remove template files (unless user is admin)
    log "STEP 5: Removing template files"
    remove_template_files
    
    # Add attempt count message
    log "STEP 6: Adding attempt count message"
    add_attempt_count_message "$MODULE" "$LEVEL" "$ATTEMPT_COUNT" "$ATTEMPT_FIRST_THRESHOLD" "$ATTEMPT_FINAL_THRESHOLD"
    
    # Add bashrc blocking message
    log "STEP 7: Adding bashrc blocking message"
    add_bashrc_message "$MODULE" "$LEVEL" "$ATTEMPT_REASON"
    
    # Display message to user
    echo ""
    echo "$BLOCK_MESSAGE"
    echo ""
    
    log "INFO: ========================================"
    log "INFO: Attempt limit enforcement COMPLETE"
    log "INFO: ========================================"
    exit 1
}

# Run main function
main "$@"
