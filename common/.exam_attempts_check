#!/usr/bin/env python3

"""
Exam Attempt Limit Checker

This script checks if a student has exceeded their exam attempt limits.
If blocked, it:
1. Replaces the flag with ATTEMPT_LIMIT_REACHED_{id}
2. Replaces main source file with block message
3. Deletes other source files
4. Adds a bashrc message

Usage: Called from .examsetup or challenge setup scripts
"""

import json
import re
import logging
import os
import sys
import time
import shutil
from pathlib import Path
import requests

# Setup logging
logging.basicConfig(
    filename='/var/log/attempt_check.log',
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s'
)

# Configuration
API_URL = os.environ.get('API_URL', 'https://api.cse545.com')
RETRY_INTERVAL = 30

# Read API token from /opt/.ring
try:
    with open('/opt/.ring', 'r') as f:
        API_TOKEN = f.read().strip()
except Exception as e:
    logging.error(f"Error reading API token from /opt/.ring: {e}")
    API_TOKEN = ""

USER_INFO_FILE = "/.user_info"
LEVEL_CONFIG = "/challenge/.config/level.json"
FLAG_FILE = "/flag"
SAVED_FLAG_FILE = "/.saved_flag"

# Colors for output
RED = '\033[0;31m'
YELLOW = '\033[1;33m'
NC = '\033[0m'  # No Color


def get_pwn_college_id():
    """Extract pwn_college_id from /.user_info"""
    try:
        with open(USER_INFO_FILE, 'r') as f:
            content = f.read()
        match = re.search(r"pwn_college_id='(\d+)'", content)
        if match:
            return match.group(1)
        logging.warning("Could not find pwn_college_id in /.user_info")
        
        # Fallback to environment variables
        pwn_id = os.environ.get('USER') or os.environ.get('PWN_USER_ID')
        if pwn_id:
            logging.info(f"Using fallback pwn_college_id from environment: {pwn_id}")
            return pwn_id
        
        logging.error("Could not determine PWN College ID")
        return None
    except Exception as e:
        logging.error(f"Error reading {USER_INFO_FILE}: {e}")
        return None


def get_level_info():
    """Get level, challenge, module, and work directory from level.json"""
    try:
        with open(LEVEL_CONFIG, 'r') as f:
            level_data = json.load(f)
        
        hwdir = level_data.get('hwdir', '')
        level = level_data.get('level', '')
        challenge = level_data.get('challenge', '')
        module = level_data.get('module', '')
        work_dir = f"{hwdir}/{level}"
        
        logging.info(f"Level info - Module: {module}, Level: {level}, Challenge: {challenge}, Work dir: {work_dir}")
        return {
            'module': module,
            'challenge': challenge,
            'work_dir': work_dir
        }
    except Exception as e:
        logging.error(f"Error reading {LEVEL_CONFIG}: {e}")
        return None


def check_attempt_limit(pwn_college_id, module, challenge):
    """Make API request to check attempt limits"""
    try:
        url = f"{API_URL}/exam-attempts/check"
        payload = {
            "pwn_college_id": pwn_college_id,
            "module": module,
            "challenge": challenge
        }
        headers = {
            'Content-Type': 'application/json',
            'X-API-Token': API_TOKEN
        }
        
        logging.info(f"Checking attempt limit for user: {pwn_college_id}, module: {module}, challenge: {challenge}")
        logging.info(f"API URL: {url}")
        logging.info(f"Request payload: {payload}")
        
        # Log headers with redacted token
        redacted_headers = headers.copy()
        if 'X-API-Token' in redacted_headers and redacted_headers['X-API-Token']:
            redacted_headers['X-API-Token'] = redacted_headers['X-API-Token'][:8] + '...[REDACTED]'
        logging.info(f"Request headers: {redacted_headers}")
        
        response = requests.post(url, json=payload, headers=headers, timeout=10)
        
        logging.info(f"HTTP Status Code: {response.status_code}")
        logging.info(f"Response body: {response.text}")
        
        if response.status_code != 200:
            logging.error(f"API call failed - HTTP {response.status_code}")
            return None
        
        data = response.json()
        logging.info(f"API Response: {data}")
        return data
        
    except Exception as e:
        logging.error(f"Error making API request: {e}")
        return None


def save_and_replace_flag(work_dir, pwn_college_id):
    """Save current flag and replace with attempt limit message"""
    flag_file = f"{work_dir}/flag"
    
    logging.debug(f"Checking for flag file at {flag_file}")
    if not os.path.exists(flag_file):
        # Try /flag instead
        flag_file = FLAG_FILE
        if not os.path.exists(flag_file):
            logging.warning(f"No flag file found at {flag_file}")
            return
    
    try:
        # Read the original flag
        with open(flag_file, 'r') as f:
            original_flag = f.read().strip()
        logging.debug(f"Original flag: {original_flag}")
        
        # Save original flag
        with open(SAVED_FLAG_FILE, 'w') as f:
            f.write(original_flag)
        os.chmod(SAVED_FLAG_FILE, 0o400)
        logging.info(f"Saved original flag to {SAVED_FLAG_FILE}")
        
        # Replace with attempt limit message
        new_flag = f"ATTEMPT_LIMIT_REACHED_{pwn_college_id}"
        with open(flag_file, 'w') as f:
            f.write(new_flag)
        logging.info(f"Flag replaced with {new_flag}")
        
    except Exception as e:
        logging.error(f"Error replacing flag: {e}")


def create_block_message(reason, module, challenge, attempts, first_threshold, final_threshold):
    """Create block message based on threshold type"""
    if reason == "final_threshold":
        return f"""===============================================
MAXIMUM ATTEMPTS REACHED
===============================================

You have reached the maximum number of attempts
for this exam problem and cannot attempt it again.

Problem: {module}/{challenge}
Attempts: {attempts}/{final_threshold}

If you believe this is an error or have extenuating
circumstances, please contact the professor.
==============================================="""
    else:
        return f"""===============================================
STAFF CONSULTATION REQUIRED
===============================================

You have reached {first_threshold} attempts on this problem.

Before you can attempt this problem again, you MUST
meet with a TA or instructor for assistance.

Problem: {module}/{challenge}
Current Attempts: {attempts}

What to do:
1. Visit office hours or request help during test session
2. A staff member will review your approach
3. After consultation, staff will clear you to continue

If not locked, you may work on other exam problems while waiting.
==============================================="""


def replace_main_file(work_dir, block_message):
    """Replace main source file with block message"""
    main_file = None
    
    # Find main.c or main.cpp
    if os.path.exists(f"{work_dir}/main.c"):
        main_file = f"{work_dir}/main.c"
    elif os.path.exists(f"{work_dir}/main.cpp"):
        main_file = f"{work_dir}/main.cpp"
    else:
        logging.warning("No main.c or main.cpp found")
        return False
    
    try:
        # Replace with block message (no backup)
        with open(main_file, 'w') as f:
            f.write(f"/*\n{block_message}\n*/\n")
        
        # Make read-only
        os.chmod(main_file, 0o444)
        logging.info(f"Replaced source file: {main_file}")
        return True
        
    except Exception as e:
        logging.error(f"Error replacing main file: {e}")
        return False


def delete_other_source_files(work_dir, keep_file):
    """Delete other source files except the one we're keeping"""
    try:
        keep_basename = os.path.basename(keep_file)
        logging.info(f"Deleting other source files in {work_dir} (keeping {keep_basename})")
        
        for ext in ['*.c', '*.h', '*.cpp']:
            for file in Path(work_dir).glob(ext):
                if file.name != keep_basename:
                    file.unlink()
                    logging.debug(f"Deleted {file}")
        
        logging.info("Source files deleted")
    except Exception as e:
        logging.error(f"Error deleting source files: {e}")


def add_bashrc_message(module, challenge, reason, attempts, first_threshold, final_threshold):
    """Add appropriate message to bashrc"""
    bashrc_file = "/etc/bash.bashrc"
    marker = f"# ATTEMPT_MESSAGE_{module}_{challenge}"
    
    try:
        # Read existing bashrc
        try:
            with open(bashrc_file, 'r') as f:
                content = f.read()
        except:
            content = ""
        
        # Remove old message if exists
        if marker in content:
            lines = content.split('\n')
            new_lines = []
            skip_next = False
            for line in lines:
                if marker in line:
                    skip_next = True
                    continue
                if skip_next:
                    skip_next = False
                    continue
                new_lines.append(line)
            content = '\n'.join(new_lines)
        
        # Create new message
        message = ""
        if reason == "final_threshold":
            message = f"echo -e '{RED}⛔ {module}/{challenge}: Maximum attempts ({final_threshold}) reached{NC}'"
        elif attempts >= first_threshold:
            remaining = final_threshold - attempts
            message = f"echo -e '{YELLOW}⚠ {module}/{challenge}: {remaining} of {final_threshold} (includes this attempt). {NC}'"
        else:
            remaining = first_threshold - attempts
            message = f"echo -e '{YELLOW}📝 {module}/{challenge}: {attempts} of {final_threshold} (includes this attempt). {NC}'"
        
        # Append to bashrc
        with open(bashrc_file, 'a') as f:
            f.write(f"\n{marker}\n{message}\n")
        
        logging.info("Added message to bashrc")
        
    except Exception as e:
        logging.warning(f"Could not write to {bashrc_file}: {e}")


def is_admin():
    """Check if user is an admin"""
    admin_file = "/.admin_access"
    
    if not os.path.exists(admin_file):
        return False
    
    try:
        with open(admin_file, 'r') as f:
            content = f.read()
        return "digital god" in content
    except:
        return False


def remove_template_files():
    """Remove template files (unless user is admin)"""
    if is_admin():
        logging.info("User is admin - preserving template files")
        return
    
    template_dir = "/challenge/template"
    
    if os.path.exists(template_dir):
        try:
            shutil.rmtree(template_dir)
            logging.info(f"Removed template directory: {template_dir}")
        except Exception as e:
            logging.warning(f"Could not remove template directory: {e}")
    else:
        logging.info(f"Template directory does not exist: {template_dir}")


def add_message_to_readme(work_dir, block_message):
    """Overwrite README.md with block message if it exists (no backup)"""
    readme_file = f"{work_dir}/README.md"
    
    if not os.path.exists(readme_file):
        logging.info(f"README.md does not exist at {readme_file}")
        return
    
    try:
        # Overwrite README with just the block message (destroying original)
        with open(readme_file, 'w') as f:
            f.write(block_message)
            f.write("\n")
        
        logging.info(f"Overwrote README.md with block message at {readme_file} (original destroyed)")
        
    except Exception as e:
        logging.error(f"Error overwriting README.md: {e}")


def main():
    logging.info("=" * 50)
    logging.info("Exam Attempt Limit Checker - Starting")
    logging.info("=" * 50)
    logging.info(f"Script version: 3.0 (Python)")
    logging.info(f"API URL: {API_URL}")
    logging.info(f"Retry interval: {RETRY_INTERVAL}s")
    logging.info(f"Pausing for 5 seconds to allow system to stabilize...")
    time.sleep(5)
    
    # Get PWN College ID
    pwn_college_id = get_pwn_college_id()
    if not pwn_college_id:
        logging.error("Could not determine PWN College ID")
        sys.exit(1)
    logging.info(f"PWN College ID: {pwn_college_id}")
    
    # Get level info
    level_info = get_level_info()
    if not level_info:
        logging.error("Could not extract level/challenge/module info")
        sys.exit(1)
    
    module = level_info['module']
    challenge = level_info['challenge']
    work_dir = level_info['work_dir']
    logging.info(f"Module: {module}, Challenge: {challenge}, Work dir: {work_dir}")
    
    # Retry loop - keep checking until API succeeds
    retry_count = 0
    while True:
        retry_count += 1
        logging.info(f"Attempt limit check #{retry_count}")
        
        # Check attempt limit
        result = check_attempt_limit(pwn_college_id, module, challenge)
        
        if result is None:
            # Error - retry
            logging.warning(f"API check failed (attempt #{retry_count}), retrying in {RETRY_INTERVAL}s...")
            print(f"Checking attempt limit... (attempt #{retry_count}, retrying in {RETRY_INTERVAL}s)")
            time.sleep(RETRY_INTERVAL)
            continue
        
        # Parse result
        allowed = result.get('allowed', False)
        reason = result.get('reason', '')
        details = result.get('details', {})
        attempts = details.get('attempts', 0)
        first_threshold = details.get('first_threshold', 3)
        final_threshold = details.get('final_threshold', 5)
        
        if allowed:
            # Allowed - add attempt count message
            logging.info(f"Attempt ALLOWED: {attempts}/{final_threshold}")
            add_bashrc_message(module, challenge, reason, attempts, first_threshold, final_threshold)
            print(f"Exam attempt check: ALLOWED ({attempts}/{final_threshold})")

            # NOTE: /opt/exam_attempt_allowed.json is NO LONGER created here.
            # It will be created by app.py AFTER successful login AND attendance verification
            # to prevent exam attempts from being registered before the student is marked as attending.
            logging.info("Attempt limit check passed - waiting for app.py to create exam_attempt_allowed.json after login")
            
            sys.exit(0)
        else:
            # Blocked - proceed to enforcement
            logging.info("Attempt BLOCKED - proceeding with enforcement")
            break
    
    # Student is BLOCKED - enforce restrictions
    logging.info("=" * 50)
    logging.info("STUDENT BLOCKED - Enforcing restrictions")
    logging.info(f"Reason: {reason}")
    logging.info(f"Attempts: {attempts}/{final_threshold}")
    logging.info("=" * 50)
    
    # Step 1: Replace flag
    logging.info("STEP 1: Replacing flag")
    save_and_replace_flag(work_dir, pwn_college_id)
    
    # Step 2: Create block message
    logging.info("STEP 2: Creating block message")
    block_message = create_block_message(reason, module, challenge, attempts, first_threshold, final_threshold)
    
    # Step 3: Overwrite README.md if it exists
    logging.info("STEP 3: Overwriting README.md if it exists")
    add_message_to_readme(work_dir, block_message)
    
    # Step 4: Replace main source file
    logging.info("STEP 4: Replacing main source file")
    main_file = None
    if replace_main_file(work_dir, block_message):
        if os.path.exists(f"{work_dir}/main.c"):
            main_file = f"{work_dir}/main.c"
        elif os.path.exists(f"{work_dir}/main.cpp"):
            main_file = f"{work_dir}/main.cpp"
    
    # Step 5: Delete other source files
    if main_file:
        logging.info("STEP 5: Deleting other source files")
        delete_other_source_files(work_dir, main_file)
    else:
        logging.info("STEP 5: Skipped (no main file)")
    
    # Step 6: Remove template files
    logging.info("STEP 6: Removing template files")
    remove_template_files()
    
    # Step 7: Add bashrc message
    logging.info("STEP 7: Adding bashrc message")
    add_bashrc_message(module, challenge, reason, attempts, first_threshold, final_threshold)
    
    # Display message to user
    print("\n" + block_message + "\n")
    
    logging.info("=" * 50)
    logging.info("Attempt limit enforcement COMPLETE")
    logging.info("=" * 50)
    sys.exit(1)


if __name__ == "__main__":
    main()
