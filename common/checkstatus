#!/usr/bin/env bash

if [ ! -x /usr/bin/exec-suid ]; then
    cat >&2 <<'EOF'
checkstatus is only available inside the pwn.college exam environment.

Please ask course staff or a proctor to check your exam access status.
EOF
    exit 1
fi

if [ -e /proc/1/environ ] && ! /bin/cat /proc/1/environ >/dev/null 2>&1; then
    cat >&2 <<'EOF'
checkstatus is not accessible from inside this locked-down exam environment.

The exam sandbox intentionally blocks the privilege change that checkstatus
normally uses. You can run checkstatus from any non-exam pwn.college module.
If you still need help, please ask course staff or your proctor to check your
exam access status.
EOF
    exit 1
fi

output=$(/usr/bin/exec-suid -- /usr/bin/python3 /challenge/bin/checkstatus.py "$@" 2>&1)
status=$?

if [ "$status" -ne 0 ] && [[ "$output" == *"Failed to read init environ"* || "$output" == *"PermissionDenied"* ]]; then
    cat >&2 <<'EOF'
checkstatus is not accessible from inside this locked-down exam environment.

The exam sandbox intentionally blocks the privilege change that checkstatus
normally uses. You can run checkstatus from any non-exam pwn.college module.
If you still need help, please ask course staff or your proctor to check your
exam access status.
EOF
    exit 1
fi

if [ -n "$output" ]; then
    printf '%s\n' "$output"
fi
exit "$status"
