#!/usr/bin/env bash

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
impl="$script_dir/checkstatus.py"

if [ ! -f "$impl" ] && [ -f /challenge/bin/checkstatus.py ]; then
    impl=/challenge/bin/checkstatus.py
fi

if [ ! -f "$impl" ]; then
    cat >&2 <<'EOF'
checkstatus is not available in this environment.

Please ask course staff or a proctor to check your exam access status.
EOF
    exit 1
fi

output=$(/usr/bin/python3 "$impl" "$@" 2>&1)
status=$?

if [ "$status" -ne 0 ] && [ -x /usr/bin/exec-suid ] && [[ "$output" == *"Permission denied"* || "$output" == *"PermissionError"* ]]; then
    output=$(/usr/bin/exec-suid -- /usr/bin/python3 "$impl" "$@" 2>&1)
    status=$?
fi

if [ "$status" -ne 0 ] && [[ "$output" == *"Failed to read init environ"* || "$output" == *"Failed to read init environment"* ]]; then
    cat >&2 <<'EOF'
checkstatus is not accessible from inside this locked-down exam environment.

The exam sandbox intentionally blocks the privilege change that checkstatus
normally uses. You can run checkstatus from any non-exam pwn.college module.
If you still need help, please ask course staff or your proctor to check your
exam access status.
EOF
    exit 1
fi

if [ -n "$output" ]; then
    printf '%s\n' "$output"
fi
exit "$status"
