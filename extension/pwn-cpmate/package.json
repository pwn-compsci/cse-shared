{
  "name": "pwn-cpmate",
  "displayName": "pwn-cpmate",
  "description": "This extension is necessary for pwn.college interactions in c and cpp.",
  "version": "0.0.2",
  "publisher": "cse240",
  "engines": {
    "vscode": ">=1.88.0"
  },
  "repository": "https://github.com/etrickel/cse240",
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "browser": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/*.txt"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pwn-cpmate.showRequirements",
        "title": "Show/Hide Requirements",
        "category": "PWN",
        "icon": "$(book)"
      },
      {
        "command": "pwn-cpmate.moveRequirementsToSplit",
        "title": "Move Requirements to Split Pane",
        "category": "PWN"
      },
      {
        "command": "pwn-cpmate.moveRequirementsToSingle",
        "title": "Move Requirements to Single Pane",
        "category": "PWN"
      },
      {
        "command": "pwn-cpmate.togglePaneMode",
        "title": "Toggle Requirements Pane Mode (Split/Single)",
        "category": "PWN"
      }
    ],
    "keybindings": [
      {
        "command": "pwn-cpmate.showRequirements",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q"
      },
      {
        "command": "pwn-cpmate.togglePaneMode",
        "key": "ctrl+alt+q",
        "mac": "cmd+alt+q"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "pwn-cpmate.showRequirements"
        }
      ]
    },
    "configuration": {
      "title": "PWN Copilot Mate",
      "properties": {
        "pwn-cpmate.autoOpenRequirements": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open requirements panel on startup if readme.html exists"
        },
        "pwn-cpmate.requirementsPaneMode": {
          "type": "string",
          "enum": ["split", "single"],
          "default": "split",
          "description": "Display requirements in split pane or single pane (overlays code)"
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "dependencies": {
    "fernet": "^0.3.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.88.0",
    "@types/mocha": "^10.0.9",
    "@types/node": "20.x",
    "eslint": "^9.13.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}